<% @title = t(en: "Features — Elio", fr: "Fonctionnalités — Elio") -%>
<% @description = t(en: "Health, inventory, vulnerabilities by package, Docker, scheduled tasks, ports and firewall, SSH keys, alerts and extensions: everything Elio does.",
                    fr: "Santé, inventaire, vulnérabilités par paquet, Docker, tâches planifiées, ports et firewall, clés SSH, alertes et extensions : tout ce que fait Elio.") -%>
<section class="mx-auto max-w-6xl px-5 pt-16 pb-6">
  <p class="eyebrow"><%= t en: "Features", fr: "Fonctionnalités" %></p>
  <h1 class="mt-3 max-w-3xl text-4xl font-semibold"><%= t en: "Everything you want to know about your servers, without logging in to each one",
                                                          fr: "Tout ce que vous voulez savoir de vos serveurs, sans vous connecter à chacun" %></h1>
  <nav class="mt-8 flex flex-wrap gap-2 text-sm" aria-label="<%= t en: "Sections", fr: "Sections" %>">
    <% [ [ "health", t(en: "Health", fr: "Santé") ], [ "vulnerabilities", t(en: "Vulnerabilities", fr: "Vulnérabilités") ], [ "docker", "Docker" ],
         [ "inventory", t(en: "Inventory", fr: "Inventaire") ], [ "ssh-keys", t(en: "SSH keys", fr: "Clés SSH") ],
         [ "alerts", t(en: "Alerts & automation", fr: "Alertes et automatisations") ], [ "extensions", "Extensions" ], [ "team", t(en: "Team", fr: "Équipe") ] ].each do |anchor, label| -%>
      <a href="#<%= anchor %>" class="rounded-full border border-line bg-surface px-3 py-1 text-ink-2 hover:text-ink"><%= label %></a>
    <% end -%>
  </nav>
</section>

<%
  sections = [
    { id: "health", eyebrow: t(en: "Health", fr: "Santé"),
      title: t(en: "Which servers are fine, which need you", fr: "Quels serveurs vont bien, lesquels ont besoin de vous"),
      points: [ t(en: "Load, memory, swap, disks and inodes, with warning and critical thresholds you set.", fr: "Charge, mémoire, swap, disques et inodes, avec des seuils d'alerte et critiques que vous réglez."),
                t(en: "Reboot required, failed systemd units by name and since when (mounts and sockets too), clock not synchronized, pending updates (security ones apart).", fr: "Redémarrage requis, unités systemd en échec par leur nom et depuis quand (montages et sockets compris), horloge non synchronisée, mises à jour en attente (dont sécurité)."),
                t(en: "End-of-support dates of Debian and Ubuntu releases.", fr: "Dates de fin de support des versions Debian et Ubuntu."),
                t(en: "30 days of history, 24-hour charts, a list or a grid of the fleet, most serious first.", fr: "30 jours d'historique, courbes sur 24 h, le parc en liste ou en grille, le plus grave d'abord."),
                t(en: "The health covers the system and its packages: an up-to-date server reads Online even when its Docker needs attention, shown apart.", fr: "La santé porte sur le système et ses paquets : un serveur à jour est En ligne même si son Docker demande de l'attention, affiché à part.") ],
      shots: [ [ "fleet-grid", t(en: "The fleet as a grid of health cards", fr: "Le parc en grille de cartes de santé") ], [ "server", t(en: "A server: health, charts and system", fr: "Un serveur : santé, courbes et système") ] ] },
    { id: "vulnerabilities", eyebrow: t(en: "Vulnerabilities", fr: "Vulnérabilités"),
      title: t(en: "The CVEs that matter, and the update that fixes them", fr: "Les CVE qui comptent, et la mise à jour qui les corrige"),
      points: [ t(en: "The Debian Security Tracker and Ubuntu's OSV data, downloaded daily for the releases of your fleet — or imported by hand in a closed network.", fr: "Le Debian Security Tracker et les données OSV d'Ubuntu, téléchargés chaque jour pour les versions de votre parc — ou importés à la main en réseau fermé."),
                t(en: "Matched with the packages already inventoried, by source package and version, like dpkg compares them: no extra command on the servers. The running kernel counts, not an old one left installed.", fr: "Rapprochés des paquets déjà inventoriés, par paquet source et version, comme dpkg les compare : aucune commande de plus sur les serveurs. C'est le noyau en cours qui compte, pas un ancien resté installé."),
                t(en: "Grouped by package: the version to install, how many CVEs it fixes, whether your repositories already offer it, and the apt command to copy.", fr: "Regroupées par paquet : la version à installer, combien de CVE elle corrige, si vos dépôts la proposent déjà, et la commande apt à copier."),
                t(en: "Scores from NVD, Red Hat and CVE.org (averaged), or from your own providers — a JSON API or a web page; exploitation from EPSS and the CISA KEV catalog.", fr: "Notes de NVD, Red Hat et CVE.org (moyennées), ou de vos propres fournisseurs — une API JSON ou une page web ; exploitation d'après EPSS et le catalogue CISA KEV."),
                t(en: "Two tabs: the CVEs of the servers' packages, and those of their Docker images, fixed by updating the image; signed packages (grub, shim, kernel, fwupd) compared with the code they sign.", fr: "Deux onglets : les CVE des paquets des serveurs, et celles de leurs images Docker, qui se corrigent en mettant à jour l'image ; les paquets signés (grub, shim, noyau, fwupd) comparés au code qu'ils signent."),
                t(en: "The commands to fix a CVE, to copy: apt-get --only-upgrade of the installed packages (after apt-get update if needed), or docker compose pull and up -d for an image. Never run by Elio.", fr: "Les commandes pour corriger une CVE, à copier : apt-get --only-upgrade des paquets installés (après apt-get update si besoin), ou docker compose pull et up -d pour une image. Jamais lancées par Elio."),
                t(en: "A click on a CVE: its description, the score and CVSS vector of each provider in plain words, the packages, the other servers touched.", fr: "Un clic sur une CVE : sa description, la note et le vecteur CVSS de chaque fournisseur en clair, les paquets, les autres serveurs touchés.") ],
      shots: [ [ "vulnerabilities-by-package", t(en: "Vulnerabilities grouped by package, with the update to make", fr: "Vulnérabilités par paquet, avec la mise à jour à faire") ],
               [ "vulnerability-detail", t(en: "A CVE in detail: scores per provider, CVSS vector in words", fr: "Une CVE en détail : notes par fournisseur, vecteur CVSS en clair") ] ] },
    { id: "docker", eyebrow: "Docker",
      title: t(en: "Containers that misbehave, images that age", fr: "Les conteneurs qui dérapent, les images qui vieillissent"),
      points: [ t(en: "A Docker state per server, apart from its health: critical for unhealthy or looping containers, to watch for vulnerable or outdated images. The Docker whale next to the health badge, with the number of problems; a filter of the fleet; its own notifications.", fr: "Un état Docker par serveur, à part de sa santé : critique pour des conteneurs en mauvaise santé ou en boucle, à surveiller pour des images vulnérables ou à mettre à jour. La baleine Docker à côté du badge de santé, avec le nombre de problèmes ; un filtre du parc ; ses propres notifications."),
                t(en: "Unhealthy containers, restart loops, containers stopped for long; CPU and memory.", fr: "Conteneurs en mauvaise santé, redémarrages en boucle, conteneurs arrêtés depuis longtemps ; CPU et mémoire."),
                t(en: "Images per server: age, size, unused ones, moving tags like latest; the same image at different versions across the fleet.", fr: "Images par serveur : âge, taille, inutilisées, tags mouvants comme latest ; la même image à des versions différentes selon les serveurs."),
                t(en: "New versions published on the registries (Docker Hub, GHCR, Quay, private ones with a read-only token), checked with HEAD requests.", fr: "Nouvelles versions publiées sur les registres (Docker Hub, GHCR, Quay, privés avec un jeton en lecture), vérifiées par des requêtes HEAD."),
                t(en: "CVEs of the images with Trivy or Grype when installed, else from the packages of the image, in the Docker tab of each server and on the Docker page, by image with the servers and containers that run it. Environment variables are never read.", fr: "CVE des images avec Trivy ou Grype s'ils sont installés, sinon d'après les paquets de l'image, dans l'onglet Docker de chaque serveur et sur la page Docker, par image avec les serveurs et conteneurs qui l'utilisent. Les variables d'environnement ne sont jamais lues.") ],
      shots: [ [ "docker", t(en: "Docker on a server: containers and images", fr: "Docker sur un serveur : conteneurs et images") ],
               [ "docker-cves", t(en: "The CVEs of the Docker images of the fleet, by image", fr: "Les CVE des images Docker du parc, par image") ] ] },
    { id: "inventory", eyebrow: t(en: "Inventory", fr: "Inventaire"),
      title: t(en: "What runs where, searchable across the fleet", fr: "Ce qui tourne où, cherchable sur tout le parc"),
      points: [ t(en: "Packages (dpkg, snap): “which servers have openssl, in which version?”", fr: "Paquets (dpkg, snap) : « quels serveurs ont openssl, et en quelle version ? »"),
                t(en: "systemd services and Docker Compose projects; scheduled tasks — crontabs and systemd timers in plain words, failed or late timers.", fr: "Services systemd et projets Docker Compose ; tâches planifiées — crontabs et timers systemd en clair, timers en échec ou en retard."),
                t(en: "Listening ports with their process, service or container; public, private or local.", fr: "Ports en écoute avec leur processus, service ou conteneur ; publics, privés ou locaux."),
                t(en: "A Firewall tab: the server's firewall (ufw, nftables, iptables) and the OVHcloud one side by side for each public port, IPv6 included, and ufw rules to copy — SSH open only to the sources you list, incoming IPv6 blocked if you want; never applied.", fr: "Un onglet Firewall : le firewall du serveur (ufw, nftables, iptables) et celui d'OVHcloud côte à côte pour chaque port public, IPv6 compris, et des règles ufw à copier — SSH ouvert seulement aux sources que vous listez, IPv6 entrant bloqué si vous le voulez ; jamais appliquées."),
                t(en: "Network addresses, WireGuard and other VPNs included; host names; search a server by IP.", fr: "Adresses réseau, WireGuard et autres VPN compris ; noms d'hôte ; recherche d'un serveur par IP.") ],
      shots: [ [ "scheduled-tasks", t(en: "Scheduled tasks of a server", fr: "Les tâches planifiées d'un serveur") ], [ "firewall", t(en: "The Firewall tab of a server", fr: "L'onglet Firewall d'un serveur") ] ] },
    { id: "ssh-keys", eyebrow: t(en: "SSH keys", fr: "Clés SSH"),
      title: t(en: "Who can log in, and for how long", fr: "Qui peut se connecter, et pour combien de temps"),
      points: [ t(en: "A keyring of the team's and the machines' public keys; add or remove one on a server in a click.", fr: "Un trousseau des clés publiques de l'équipe et des machines ; en ajouter ou en retirer une sur un serveur en un clic."),
                t(en: "Temporary access: the key expires on its own (OpenSSH expiry-time), even if Elio is down. \"Add my key\": your own key on a server for an hour, in one click.", fr: "Accès temporaires : la clé expire toute seule (expiry-time d'OpenSSH), même si Elio est arrêté. « Ajouter ma clé » : votre propre clé sur un serveur pour une heure, en un clic."),
                t(en: "With root, the keys of every account of a server, added to or removed from any of them (links and files the account does not own are refused, accounts are never created).", fr: "Avec root, les clés de tous les comptes d'un serveur, ajoutées ou retirées sur chacun (liens et fichiers qui n'appartiennent pas au compte refusés, aucun compte créé)."),
                t(en: "Keys found on a server and unknown to the keyring are flagged and gathered in an Outside the keyring list; rotation of Elio's own key without downtime.", fr: "Les clés trouvées sur un serveur et inconnues du trousseau sont signalées et réunies dans une liste Hors trousseau ; rotation de la clé d'Elio sans coupure.") ],
      shots: [ [ "ssh-keys", t(en: "The SSH keys of every account of a server", fr: "Les clés SSH de tous les comptes d'un serveur") ],
               [ "keyring-outside", t(en: "The keys of the fleet that are in no keyring key", fr: "Les clés du parc absentes du trousseau") ] ] },
    { id: "alerts", eyebrow: t(en: "Alerts & automation", fr: "Alertes et automatisations"),
      title: t(en: "Told when it matters, quiet otherwise", fr: "Prévenu quand ça compte, tranquille sinon"),
      points: [ t(en: "The overview lists what needs attention, most serious first, with a button to act.", fr: "La vue d'ensemble liste ce qui demande attention, le plus grave d'abord, avec un bouton pour agir."),
                t(en: "A journal of everything that changed, searchable (server, key, service, package, CVE…) over a period; notifications to Slack, Discord, email or signed webhooks, chosen per kind and grouped by type over a few minutes (critical ones right away); a daily digest.", fr: "Un journal de tout ce qui a changé, avec une recherche (serveur, clé, service, paquet, CVE…) sur une période ; notifications Slack, Discord, email ou webhooks signés, au choix par type et regroupées par type sur quelques minutes (les critiques tout de suite) ; un résumé quotidien."),
                t(en: "Every collection on schedule, on the fleet or per group, followed live in the Runs tab of the Journal.", fr: "Chaque collecte à la fréquence voulue, sur le parc ou par groupe, suivie en direct dans l'onglet Exécutions du Journal.") ],
      shots: [ [ "overview", t(en: "The overview: what needs attention", fr: "La vue d'ensemble : ce qui est à traiter") ], [ "automations", t(en: "Automations", fr: "Automatisations") ] ] }
  ]
-%>
<% sections.each_with_index do |section, index| -%>
<section id="<%= section[:id] %>" class="mx-auto mt-20 grid max-w-6xl items-start gap-10 px-5 lg:grid-cols-5">
  <div class="lg:col-span-2 <%= "lg:order-2" if index.odd? %>">
    <p class="eyebrow"><%= section[:eyebrow] %></p>
    <h2 class="mt-3 text-2xl font-semibold"><%= section[:title] %></h2>
    <ul class="mt-5 space-y-3 text-ink-2">
      <% section[:points].each do |point| -%>
        <li class="flex gap-3"><span class="mt-1 text-accent"><%= icon(:check, "h-4 w-4") %></span><span><%= point %></span></li>
      <% end -%>
    </ul>
  </div>
  <div class="space-y-6 lg:col-span-3">
    <% section[:shots].each do |shot, alt| -%>
      <figure><%= screenshot(shot, alt) %><figcaption class="mt-2 text-center text-sm text-ink-3"><%= alt %></figcaption></figure>
    <% end -%>
  </div>
</section>
<% end -%>

<section id="extensions" class="mx-auto mt-20 max-w-6xl px-5">
  <p class="eyebrow">Extensions</p>
  <h2 class="mt-3 max-w-2xl text-2xl font-semibold"><%= t en: "What your other tools know, next to each server", fr: "Ce que savent vos autres outils, à côté de chaque serveur" %></h2>
  <p class="lead mt-3 max-w-3xl"><%= t en: "Enabled in the settings, they only read: Elio never creates, changes or deletes anything on these services. A disabled extension leaves no trace in the interface, and each of their alerts is optional.",
                                         fr: "Activées dans les paramètres, elles ne font que lire : Elio ne crée, ne modifie et ne supprime jamais rien sur ces services. Une extension désactivée ne laisse aucune trace dans l'interface, et chacune de leurs alertes est au choix." %></p>

  <div class="mt-10 grid items-start gap-10 lg:grid-cols-5">
    <div class="lg:col-span-2">
      <h3 class="text-xl font-semibold">Uptime Kuma</h3>
      <ul class="mt-4 space-y-3 text-ink-2">
        <% [ t(en: "Reads the /metrics page of your instance every 15 minutes, with an API key (Uptime Kuma 1.x and 2.x).", fr: "Lit la page /metrics de votre instance toutes les 15 minutes, avec une clé d'API (Uptime Kuma 1.x et 2.x)."),
             t(en: "Attaches each monitor to its server: by the IP it watches (WireGuard included), by host name — with DNS resolution as an option — or by the server's name in the monitor's name. Corrections by hand are kept.", fr: "Rattache chaque sonde à son serveur : par l'IP surveillée (WireGuard compris), par le nom d'hôte — avec résolution DNS en option — ou par le nom du serveur dans celui de la sonde. Les corrections à la main sont gardées."),
             t(en: "A prompt to copy into an AI assistant, built from the server's inventory, to propose the monitors to create.", fr: "Un prompt à copier dans un assistant IA, construit d'après l'inventaire du serveur, pour proposer les sondes à créer."),
             t(en: "A Monitors tab on each server; a page with the monitors attached to no server and the servers without any monitor.", fr: "Un onglet Sondes sur chaque serveur ; une page avec les sondes rattachées à aucun serveur et les serveurs sans sonde."),
             t(en: "Alerts to choose: server without a monitor, monitor down or back, certificate about to expire, uptime under a threshold, maintenance that lasts.", fr: "Alertes au choix : serveur sans sonde, sonde hors ligne ou de retour, certificat bientôt expiré, disponibilité sous un seuil, maintenance qui dure.") ].each do |point| -%>
          <li class="flex gap-3"><span class="mt-1 text-accent"><%= icon(:check, "h-4 w-4") %></span><span><%= point %></span></li>
        <% end -%>
      </ul>
    </div>
    <figure class="lg:col-span-3"><%= screenshot("uptime-kuma-monitors", t(en: "The Uptime Kuma monitors, attached to the servers", fr: "Les sondes Uptime Kuma, rattachées aux serveurs")) %>
      <figcaption class="mt-2 text-center text-sm text-ink-3"><%= t en: "The monitors and the server each one watches", fr: "Les sondes et le serveur que chacune surveille" %></figcaption></figure>
  </div>

  <div class="mt-16 grid items-start gap-10 lg:grid-cols-5">
    <div class="lg:order-2 lg:col-span-2">
      <h3 class="text-xl font-semibold">OVHcloud</h3>
      <ul class="mt-4 space-y-3 text-ink-2">
        <% [ t(en: "An API key limited to GET requests: Elio lists the exact rights for the products you check and opens OVH's token page already filled in; the connection test warns if the key could write.", fr: "Une clé d'API limitée aux requêtes GET : Elio liste les droits exacts pour les produits cochés et ouvre la page de création de jeton d'OVH déjà remplie ; le test de connexion prévient si la clé permet d'écrire."),
             t(en: "Each product is a checkbox: IPs and reverse DNS, network firewall, anti-DDoS, DNS zones, dedicated servers, VPS, Public Cloud instances.", fr: "Chaque produit est une case à cocher : IP et reverse DNS, firewall réseau, anti-DDoS, zones DNS, serveurs dédiés, VPS, instances Public Cloud."),
             t(en: "A Hosting card on each server: the OVHcloud service and its expiration, the IPs and reverse; the network firewall rules, whether they let each public port through (IPv4 only: IPv6 is not covered) and a prompt for an AI assistant are in the Firewall tab; its DNS records go to the DNS of the fleet.", fr: "Une carte Hébergement sur chaque serveur : le service OVHcloud et son expiration, les IP et reverse ; les règles du firewall réseau, si elles laissent passer chaque port public (IPv4 seulement : l'IPv6 n'est pas couvert) et un prompt pour un assistant IA sont dans l'onglet Firewall ; ses enregistrements DNS vont dans le DNS du parc."),
             t(en: "Alerts to choose: service about to expire, firewall disabled (IPv4 blocks: OVHcloud has none for IPv6), reverse DNS that does not match, OVH service not followed by Elio.", fr: "Alertes au choix : service bientôt expiré, firewall désactivé (blocs IPv4 : OVHcloud n'en a pas pour l'IPv6), reverse DNS qui ne correspond pas, service OVH non suivi par Elio.") ].each do |point| -%>
          <li class="flex gap-3"><span class="mt-1 text-accent"><%= icon(:check, "h-4 w-4") %></span><span><%= point %></span></li>
        <% end -%>
      </ul>
    </div>
    <figure class="lg:col-span-3"><%= screenshot("ovh", t(en: "The Hosting card of a server: OVHcloud service, IPs and reverse", fr: "La carte Hébergement d'un serveur : service OVHcloud, IP et reverse")) %>
      <figcaption class="mt-2 text-center text-sm text-ink-3"><%= t en: "What OVH knows about a server", fr: "Ce qu'OVH sait d'un serveur" %></figcaption></figure>
  </div>
  <div class="mt-16 max-w-3xl">
    <h3 class="text-xl font-semibold">Technitium DNS</h3>
    <ul class="mt-4 space-y-3 text-ink-2">
      <% [ t(en: "The API token of a user that can only view the zones; the connection test gives the version and warns if the token could change them.", fr: "Le jeton d'API d'un utilisateur qui peut seulement voir les zones ; le test de connexion donne la version et prévient si le jeton permet de les modifier."),
           t(en: "The A, AAAA and CNAME records of the zones, attached to the servers they point to (by IP, or by the name a CNAME points to), or by hand.", fr: "Les enregistrements A, AAAA et CNAME des zones, rattachés aux serveurs vers lesquels ils pointent (par IP, ou par le nom visé par un CNAME), ou à la main."),
           t(en: "One DNS of the fleet with OVHcloud's and Gandi's records: one DNS tab and one DNS page, the source of each record, names that differ between sources flagged.", fr: "Un seul DNS du parc avec les enregistrements d'OVHcloud et de Gandi : un onglet et une page DNS, la source de chaque enregistrement, les noms qui diffèrent selon la source signalés."),
           t(en: "Common DNS alerts: record pointing outside the fleet, server without a DNS name; the fleet search, ⌘K and Uptime Kuma use these names.", fr: "Alertes DNS communes : enregistrement hors du parc, serveur sans nom DNS ; la recherche du Parc, ⌘K et Uptime Kuma utilisent ces noms.") ].each do |point| -%>
        <li class="flex gap-3"><span class="mt-1 text-accent"><%= icon(:check, "h-4 w-4") %></span><span><%= point %></span></li>
      <% end -%>
    </ul>
  </div>
  <div class="mt-16 max-w-3xl">
    <h3 class="text-xl font-semibold">Gandi</h3>
    <ul class="mt-4 space-y-3 text-ink-2">
      <% [ t(en: "A personal access token with read rights only (domains and LiveDNS records); GET requests only, the token in an Authorization header.", fr: "Un jeton d'accès personnel avec des droits de lecture seulement (domaines et enregistrements LiveDNS) ; uniquement des requêtes GET, le jeton dans un en-tête Authorization."),
           t(en: "The A, AAAA and CNAME records of the domains served by LiveDNS, in the DNS of the fleet like the other sources.", fr: "Les enregistrements A, AAAA et CNAME des domaines servis par LiveDNS, dans le DNS du parc comme les autres sources."),
           t(en: "Your domains with their expiry date and auto renewal, and an optional alert when one is about to expire.", fr: "Vos domaines avec leur date d'expiration et leur renouvellement automatique, et une alerte en option quand l'un d'eux va expirer.") ].each do |point| -%>
        <li class="flex gap-3"><span class="mt-1 text-accent"><%= icon(:check, "h-4 w-4") %></span><span><%= point %></span></li>
      <% end -%>
    </ul>
  </div>
  <div class="mt-16 max-w-3xl">
    <h3 class="text-xl font-semibold">Coolify</h3>
    <ul class="mt-4 space-y-3 text-ink-2">
      <% [ t(en: "One connection per Coolify team (a token only sees its team), as many instances as needed; read tokens, GET requests only, a warning if a token can read secrets.", fr: "Une connexion par équipe Coolify (un jeton ne voit que son équipe), autant d'instances que nécessaire ; des jetons read, uniquement des requêtes GET, un avertissement si un jeton lit les secrets."),
           t(en: "A Coolify tab on each server it manages: applications, services and databases with their project, domains, deployed version and state, the recent deployments and the database backups; a Coolify page for the whole fleet.", fr: "Un onglet Coolify sur chaque serveur qu'il gère : applications, services et bases avec leur projet, leurs domaines, la version déployée et leur état, les déploiements récents et les sauvegardes de bases ; une page Coolify pour tout le parc."),
           t(en: "Readable names in the Docker tab, the ports and the prompts; deployments in the server's journal; Coolify's SSH key recognized.", fr: "Des noms lisibles dans l'onglet Docker, les ports et les prompts ; les déploiements dans le journal du serveur ; la clé SSH de Coolify reconnue."),
           t(en: "Alerts to choose: backup failed or late, database without backup or made public, failed deployment, resource stopped or unhealthy, server Coolify cannot reach, domain whose DNS points elsewhere.", fr: "Alertes au choix : sauvegarde en échec ou en retard, base sans sauvegarde ou rendue publique, déploiement en échec, ressource arrêtée ou en mauvaise santé, serveur que Coolify ne joint plus, domaine dont le DNS pointe ailleurs.") ].each do |point| -%>
        <li class="flex gap-3"><span class="mt-1 text-accent"><%= icon(:check, "h-4 w-4") %></span><span><%= point %></span></li>
      <% end -%>
    </ul>
  </div>
  <div class="mt-16 max-w-3xl">
    <h3 class="text-xl font-semibold"><%= t en: "Manual DNS", fr: "DNS manuel" %></h3>
    <ul class="mt-4 space-y-3 text-ink-2">
      <% [ t(en: "For a DNS that has no extension: name a source and paste its records as CSV (name, type, value, TTL).", fr: "Pour un DNS qui n'a pas d'extension : nommez une source et collez ses enregistrements en CSV (nom, type, valeur, TTL)."),
           t(en: "A preview shows what will be read and every refused line with its reason, before anything is saved.", fr: "Un aperçu montre ce qui sera lu et chaque ligne refusée avec sa raison, avant tout enregistrement."),
           t(en: "Its records join the DNS of the fleet like the other sources: attached to the servers, compared, alerted on.", fr: "Ses enregistrements rejoignent le DNS du parc comme les autres sources : rattachés aux serveurs, comparés, surveillés.") ].each do |point| -%>
        <li class="flex gap-3"><span class="mt-1 text-accent"><%= icon(:check, "h-4 w-4") %></span><span><%= point %></span></li>
      <% end -%>
    </ul>
  </div>
  <p class="mt-8 text-sm text-ink-3"><%= t en: "Uptime Kuma, OVHcloud and Gandi are not yet tried on real accounts: built and tested on recorded or documented API answers (Technitium DNS and Coolify were tried on real instances). Feedback welcome.", fr: "Uptime Kuma, OVHcloud et Gandi ne sont pas encore essayées sur de vrais comptes : construites et testées sur des réponses d'API enregistrées ou documentées (Technitium DNS et Coolify ont été essayés sur de vraies instances). Vos retours sont bienvenus." %></p>
</section>

<section id="team" class="mx-auto mt-20 max-w-6xl px-5">
  <p class="eyebrow"><%= t en: "Team", fr: "Équipe" %></p>
  <h2 class="mt-3 text-2xl font-semibold"><%= t en: "Made to be shared, safely", fr: "Fait pour être partagé, sans risque" %></h2>
  <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
    <% [ [ t(en: "Roles", fr: "Rôles"), t(en: "Administrators, operators and read-only users.", fr: "Administrateurs, opérateurs et lecture seule.") ],
         [ t(en: "Two-factor authentication", fr: "Double authentification"), t(en: "TOTP and backup codes, mandatory by default for admins and operators.", fr: "TOTP et codes de secours, obligatoire par défaut pour les admins et opérateurs.") ],
         [ t(en: "Invitations", fr: "Invitations"), t(en: "No public sign-up: the first account, then invitations only.", fr: "Pas d'inscription publique : le premier compte, puis des invitations.") ],
         [ t(en: "Notes", fr: "Notes"), t(en: "What the team should know about a server, in Markdown, in its Journal with its history.", fr: "Ce que l'équipe doit savoir d'un serveur, en Markdown, dans son Journal avec son historique.") ],
         [ t(en: "Everywhere", fr: "Partout"), t(en: "⌘K search, light and dark themes, works on a phone. Interface in English and French.", fr: "Recherche ⌘K, thèmes clair et sombre, utilisable sur téléphone. Interface en anglais et en français.") ] ].each do |title, text| -%>
      <div class="card p-5"><h3 class="font-semibold"><%= title %></h3><p class="mt-1.5 text-sm text-ink-2"><%= text %></p></div>
    <% end -%>
  </div>
</section>
