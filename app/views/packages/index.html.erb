<% content_for :title, t("title", page: t("nav.packages")) %>

<%= page_header t("nav.packages"), subtitle: t(".which_servers_have_package") %>

<%= form_with url: packages_path, method: :get, data: { turbo_action: "advance" }, class: "packages-search" do |f| %>
  <%= filter_bar do %>
    <%= f.search_field :q, value: @q, placeholder: t(".search_placeholder"), autofocus: true, autocomplete: "off",
          aria: { label: t(".package_name") }, class: "input w-80 py-1.5" %>
    <%= f.button class: "btn btn-secondary" do %><%= icon :magnifying_glass %> <%= t(".search") %><% end %>
    <% if @q.present? %><%= link_to t("ui.clear_filters"), packages_path, class: "text-xs text-accent hover:underline" %><% end %>
    <% if @servers_without_inventory.positive? %>
      <%= filter_bar_end do %><span class="text-xs text-ink-3"><%= t(".packages_inventory_yet_html", t: (t("count.servers_have", count: @servers_without_inventory))) %></span><% end %>
    <% end %>
  <% end %>
<% end %>

<% if @q.present? %>
  <% if @results.any? %>
    <div class="space-y-4">
      <% @results.each do |name, rows| %>
        <section class="package-result card">
          <div class="card-header">
            <h2 class="font-semibold"><%= name %> <span class="text-xs font-normal text-ink-3"><%= rows.first.manager_label %></span></h2>
            <span class="text-xs text-ink-3"><%= t("count.servers", count: rows.map(&:server_id).uniq.size) %> · <%= t("count.versions", count: @versions[name].size) %></span>
          </div>
          <table class="table-dense">
            <thead><tr><th class="pl-4"><%= t("words.version") %></th><th><%= t(".update") %></th><th class="pr-4"><%= t(".servers") %></th></tr></thead>
            <tbody>
              <% @versions[name].each do |version, packages| %>
                <tr class="package-version">
                  <td class="pl-4 font-mono text-xs"><%= version %></td>
                  <td class="text-xs">
                    <% if (update = packages.find(&:upgradable?)) %>
                      <span class="font-mono text-ink-2">→ <%= update.available_version %></span>
                      <% if packages.any?(&:security) %><span class="badge ml-1 bg-crit-soft text-crit-ink"><%= t(".security") %></span><% end %>
                    <% else %>
                      <span class="text-ink-3"><%= t(".up_date") %></span>
                    <% end %>
                  </td>
                  <td class="pr-4">
                    <div class="flex flex-wrap gap-1.5">
                      <% packages.map(&:server).uniq.sort_by(&:name).each do |server| %>
                        <%= link_to server.name, server_path(server, tab: "packages"), class: "badge bg-subtle text-ink-2 hover:text-ink" %>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </section>
      <% end %>
    </div>
    <%= render "shared/pagination", pager: @pager, noun: t("nouns.packages") %>
  <% else %>
    <div class="card"><%= empty_state t(".package_contains_html", q: @q), icon: :magnifying_glass %></div>
  <% end %>
<% else %>
  <section class="security-updates card">
    <div class="card-header">
      <h2 class="flex items-center gap-2 font-semibold"><%= icon :shield_check, class: "h-4 w-4 text-ink-3" %> <%= t(".pending_security_updates") %></h2>
      <span class="text-xs text-ink-3"><%= t("count.packages", count: @pager.total) %></span>
    </div>
    <% if @security.any? %>
      <table class="table-dense">
        <thead><tr><th class="pl-4"><%= t(".package") %></th><th><%= t(".available_version") %></th><th class="pr-4"><%= t(".servers_concerned") %></th></tr></thead>
        <tbody>
          <% @security.each do |name, packages| %>
            <tr class="security-update">
              <td class="pl-4 font-medium"><%= link_to name, packages_path(q: name), class: "hover:text-accent hover:underline" %></td>
              <td class="font-mono text-xs text-ink-2"><%= packages.map(&:available_version).uniq.join(", ") %></td>
              <td class="pr-4">
                <div class="flex flex-wrap gap-1.5">
                  <% packages.map(&:server).uniq.sort_by(&:name).each do |server| %>
                    <%= link_to server.name, server_path(server, tab: "packages"), class: "badge bg-subtle text-ink-2 hover:text-ink" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <% if @pager.multiple_pages? %><div class="border-t border-line px-4 pb-3"><%= render "shared/pagination", pager: @pager, noun: t("nouns.packages") %></div><% end %>
    <% else %>
      <p class="flex items-center gap-2 px-4 py-4 text-sm text-good-ink"><%= icon :check_circle %> <%= t(".pending_security_update") %></p>
    <% end %>
  </section>
<% end %>
