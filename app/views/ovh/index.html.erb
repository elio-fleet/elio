<% content_for :title, t("title", page: t("nav.hosting")) %>

<% subtitle = safe_join([ source_tag("OVHcloud"), " ", t(".resources_ovhcloud_account_attached"), (t(".synchronized_html", last_synced_at: relative_time_tag(@integration.last_synced_at)) if @integration.last_synced_at), ".",
                          (tag.span(t(".last_sync_failed_html", last_error: @integration.last_error), class: "ml-1 text-crit-ink") if @integration.last_error) ].compact) %>
<%= page_header t("nav.hosting"), subtitle: subtitle do %>
  <% if can?(:administer) %>
    <%= actions_menu do %><%= menu_item t("ui.extension_settings"), edit_settings_integration_path(@integration.kind), icon: :cog %><% end %>
  <% end %>
<% end %>

<%= stat_tiles do %>
  <%= stat_tile t(".services"), @counts.slice(*OvhResource::SERVICE_KINDS).values.sum, t(".dedicated_vps_instances"), icon: :server_stack, id: "stat-ovh-services", href: ovh_path %>
  <%= stat_tile t(".not_attached"), @unattached_services, t(".services_outside_fleet"), tone: (@unattached_services.positive? ? :warn : nil), icon: :exclamation_triangle, id: "stat-ovh-unattached",
                href: ovh_path(unattached: 1), active: params[:unattached] == "1" %>
  <%= stat_tile t(".expiring_soon"), @expiring, nil, tone: (@expiring.positive? ? :warn : nil), icon: :clock, id: "stat-ovh-expiring" %>
  <%= stat_tile t(".dns_names"), @dns_count, t(".dns_names_caption"), icon: :list_bullet, id: "stat-ovh-dns", href: dns_records_path(source: "ovh") %>
<% end %>

<%= tabs [ [ "services", t(".services"), @counts.slice(*OvhResource::SERVICE_KINDS).values.sum ], [ "ips", t(".ip_addresses"), @counts["ip"].to_i ] ].map { |tab, label, count| { key: tab, label: label, count: count, path: ovh_path(tab: tab) } },
         current: @tab, label: t(".resources"), class: "ovh-tabs" %>

<%= form_with url: ovh_path, method: :get, data: search_form_data, class: "filter-bar mb-3 flex flex-wrap items-center gap-3" do |f| %>
  <%= hidden_field_tag :tab, @tab %>
  <%= f.search_field :q, value: @q, placeholder: t(".name_ip_target"), aria: { label: t(".search") }, data: { action: "input->auto-submit#submitLater" }, class: "input w-56 py-1.5" %>
  <label class="flex items-center gap-1.5 text-xs text-ink-2">
    <%= check_box_tag :unattached, "1", params[:unattached] == "1", data: { action: "change->auto-submit#submit" }, class: "h-4 w-4 rounded border-line text-accent" %>
    <%= t(".not_attached_only") %>
  </label>
<% end %>

<%= search_results_frame do %>
<% if @pager.records.any? %>
  <div class="card overflow-x-auto">
    <table id="ovh-resources" class="table-dense">
      <thead>
        <tr>
          <% if @tab == "services" %><th class="pl-4"><%= t("words.service") %></th><th>Type</th><th><%= t("words.offer") %></th><th>Datacenter</th><th><%= t("words.expiry") %></th>
          <% else %><th class="pl-4"><%= t(".ip_block") %></th><th>Type</th><th><%= t(".ovh_service") %></th><th><%= t("words.firewall") %></th>
          <% end %>
          <th><%= t(".server") %></th>
          <% if can?(:operate) %><th class="pr-4 text-right"><%= t(".attach") %></th><% end %>
        </tr>
      </thead>
      <tbody>
        <% @pager.records.each do |resource| %>
          <tr id="<%= dom_id(resource) %>" class="ovh-resource" data-kind="<%= resource.kind %>">
            <% if @tab == "services" %>
              <td class="pl-4"><span class="font-medium"><%= resource.name %></span><span class="block font-mono text-[11px] text-ink-3"><%= resource.addresses.first(2).join(", ") %></span></td>
              <td class="text-xs"><%= resource.kind_label %></td>
              <td class="text-xs"><%= resource.data["offer"] || "—" %></td>
              <td class="text-xs"><%= resource.data["datacenter"] || resource.data["region"] || "—" %></td>
              <td class="whitespace-nowrap text-xs"><%= ovh_expiration(resource) %></td>
            <% else %>
              <td class="pl-4 font-mono text-xs"><%= resource.name %></td>
              <td class="text-xs"><%= resource.data["type"] %></td>
              <td class="font-mono text-xs"><%= resource.data["service"] || "—" %></td>
              <td class="text-xs">
                <% firewalls = Array(resource.data["firewall"]).map(&:last) %>
                <%= resource.data.key?("firewall") ? (firewalls.any? { _1["enabled"] } ? t(".text") : t(".off")) : "—" %>
              </td>
            <% end %>
            <td class="ovh-server whitespace-nowrap text-xs">
              <% if resource.server %>
                <%= link_to resource.server.name, server_path(resource.server, anchor: "server-hosting"), class: "hover:text-accent hover:underline" %>
                <span class="block text-[11px] text-ink-3"><%= ovh_match_label(resource) %></span>
              <% else %>
                <span class="text-ink-3"><%= t(".not_attached_2") %></span>
              <% end %>
            </td>
            <% if can?(:operate) %>
              <td class="pr-4 text-right"><%= render "integrations/ovh/link_form", resource: resource %></td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= render "shared/pagination", pager: @pager, noun: t("nouns.resources") %>
<% else %>
  <div class="card">
    <% if @q.present? || params[:unattached] == "1" %>
      <%= empty_state t(".resource_matches"), icon: :magnifying_glass do %><%= link_to t("ui.clear_filters"), ovh_path(tab: @tab), class: "btn btn-secondary" %><% end %>
    <% elsif @integration.last_synced_at %>
      <%= empty_state t(".none_#{@tab}"), t(".none_hint"), icon: :cloud %>
    <% else %>
      <%= empty_state t(".not_synchronized_ovhcloud_yet"), icon: :cloud %>
    <% end %>
  </div>
<% end %>
<% end %>
