<% content_for :title, t("title", page: t("nav.docker")) %>

<div>
  <h1 class="text-xl font-semibold">Docker</h1>
  <p class="text-xs text-ink-3"><%= t("docker.cves.intro") %></p>
</div>

<div class="mt-5 grid grid-cols-2 gap-3 lg:grid-cols-4">
  <%= stat_tile t("docker.cves.images"), @summary[:images], nil, icon: :container, id: "stat-vulnerable-images" %>
  <%= stat_tile t("docker.cves.cves"), @summary[:cves], nil, icon: :shield_exclamation, id: "stat-image-cves" %>
  <%= stat_tile t("docker.cves.fixable"), @summary[:fixable], t("docker.cves.by_updating"), tone: (:warn if @summary[:fixable].positive?), id: "stat-image-fixable" %>
  <%= stat_tile t("docker.cves.servers"), @summary[:servers], nil, icon: :server_stack, id: "stat-image-servers" %>
</div>

<%= render "docker/tabs" %>

<%= form_with url: docker_path, method: :get, data: search_form_data, class: "docker-filters mt-3 flex flex-wrap items-center gap-2" do |f| %>
  <%= hidden_field_tag :tab, "cves" %>
  <%= f.search_field :q, value: @q, placeholder: t("docker.index.image_e_g_nginx"), aria: { label: t("docker.index.image") }, data: { action: "input->auto-submit#submitLater" }, class: "input w-56 py-1 text-xs" %>
  <%= f.select :group, [ [ t("docker.index.all_groups"), "" ], *@groups.map { |group| [ group.name, group.id ] } ], { selected: @group&.id },
        aria: { label: t("docker.index.group") }, data: { action: "change->auto-submit#submit" }, class: "input w-auto py-1 text-xs" %>
  <noscript><%= f.submit t("docker.index.filter"), class: "btn btn-secondary" %></noscript>
<% end %>

<%= search_results_frame do %>
  <% if @images.any? %>
    <div class="mt-3 space-y-3">
      <% @images.each do |image| %>
        <section class="image-vulnerabilities card" data-image="<%= image.image %>">
          <div class="flex flex-wrap items-start gap-x-4 gap-y-2 px-4 py-3">
            <div class="min-w-0 flex-1">
              <p class="flex flex-wrap items-center gap-2">
                <%= severity_badge(image.severity) %>
                <span class="font-mono text-sm font-medium"><%= image.image %></span>
                <%= score_pill(image.max_score, title: t("docker.cves.highest_score")) %>
              </p>
              <p class="mt-1 text-xs text-ink-2">
                <%= t("docker.cves.counts_html", cves: tag.strong(image.cve_count, class: "text-ink"), fixable: tag.strong(t("docker.cves.fixable_count", count: image.fixable_count), class: image.fixable_count.positive? ? "text-warn-ink" : "text-ink")) %>
              </p>
              <p class="image-uses mt-1 text-xs text-ink-3">
                <% if image.uses.any? %>
                  <%= t("docker.cves.used_by") %>
                  <%= safe_join(image.uses.group_by(&:first).map { |server, uses| safe_join([ link_to(server.name, server_path(server, tab: "docker"), class: "font-medium text-ink-2 hover:text-accent hover:underline"), " (#{uses.map { |_, container| container["name"] }.join(", ")})" ]) }, ", ") %>
                <% else %>
                  <%= t("docker.cves.on_servers") %>
                  <%= safe_join(image.servers.map { |server| link_to(server.name, server_path(server, tab: "docker"), class: "font-medium text-ink-2 hover:text-accent hover:underline") }, ", ") %>
                <% end %>
              </p>
            </div>
            <p class="image-advice max-w-sm text-xs text-ink-2">
              <%= image.fixable_count.positive? ? t("docker.cves.advice_update") : t("docker.cves.advice_none") %>
            </p>
          </div>
          <details class="border-t border-line">
            <summary class="cursor-pointer px-4 py-2 text-xs font-medium text-accent hover:underline"><%= t("docker.cves.by_package", count: image.package_count) %></summary>
            <%= turbo_frame_tag image.frame_id, src: docker_image_cves_path(image: image.image, group: @group&.id), loading: :lazy, target: "_top" do %>
              <p class="px-4 py-3 text-xs text-ink-3"><%= t("docker.cves.loading") %></p>
            <% end %>
          </details>
        </section>
      <% end %>
    </div>
    <%= render "shared/pagination", pager: @pager, noun: t("nouns.images") %>
  <% else %>
    <p class="card mt-3 px-4 py-6 text-sm text-ink-3"><%= @q.present? ? t("docker.cves.none_matches") : t("docker.cves.none") %></p>
  <% end %>
<% end %>
