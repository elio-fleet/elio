<% content_for :title, t("title", page: t("nav.docker")) %>

<%= page_header "Docker", subtitle: t(".containers_images_whole_fleet") %>

<%= stat_tiles do %>
  <%= stat_tile t(".running_containers"), "#{@summary[:running]}/#{@summary[:containers]}", t("count.servers", count: @summary[:servers]), icon: :docker, id: "stat-containers" %>
  <%= stat_tile t(".trouble"), @summary[:troubled], t(".loop_unhealthy"), tone: (:crit if @summary[:troubled].positive?), icon: :x_mark, id: "stat-troubled",
                href: (docker_path(anchor: "troubled-containers") if @summary[:troubled].positive?) %>
  <%= stat_tile t(".new_versions"), @summary[:updates], t(".images_update"), tone: (:warn if @summary[:updates].positive?), icon: :arrow_up_circle, id: "stat-updates",
                href: docker_path(updates: 1), active: params[:updates] == "1" %>
  <%= stat_tile t(".image_cves"), @summary[:image_cves], t(".image_cves_detail", images: t("count.docker_images", count: @summary[:vulnerable_images]), count: @summary[:image_fixable]),
                tone: (:warn if @summary[:image_fixable].positive?), icon: :shield_exclamation, id: "stat-image-cves", href: docker_path(tab: "cves") %>
<% end %>

<%= render "docker/tabs" %>

<% if @troubled.any? %>
  <section id="troubled-containers" class="card mb-4">
    <div class="card-header"><h2 class="font-semibold"><%= t(".containers_watch") %></h2></div>
    <ul class="divide-y divide-line">
      <% @troubled.each do |server, container| %>
        <li class="troubled-container flex flex-wrap items-center gap-x-3 gap-y-1 px-4 py-2 text-sm">
          <span class="w-44 shrink-0"><%= container_state_badge(container) %></span>
          <%= link_to server.name, server_path(server, tab: "docker"), class: "font-medium hover:text-accent hover:underline" %>
          <span class="font-mono text-xs"><%= container["name"] %></span>
          <span class="text-xs text-ink-3"><%= container["image"] %></span>
          <span class="ml-auto text-xs text-ink-3">
            <% if container["looping"] %><%= t(".restarts_html", restarts: (container["restarts"])) %>
            <% elsif container["stopped_long"] %><%= t(".stopped_html", parse: (relative_time_tag Time.zone.parse(container["finished_at"]))) %><% end %>
          </span>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>



<%= form_with url: docker_path, method: :get, data: search_form_data, class: "docker-filters mt-3 flex flex-wrap items-center gap-2" do |f| %>
  <%= f.search_field :q, value: @q, placeholder: t(".image_e_g_nginx"), aria: { label: t(".image") }, data: { action: "input->auto-submit#submitLater" }, class: "input w-56 py-1.5" %>
  <%= f.select :group, [ [ t(".all_groups"), "" ], *@groups.map { |group| [ group.name, group.id ] } ], { selected: @group&.id },
        aria: { label: t(".group") }, data: { action: "change->auto-submit#submit" }, class: "input w-auto py-1.5" %>
  <label class="flex items-center gap-1.5 text-xs"><%= t(".new_version_available_html", submit: (check_box_tag :updates, "1", @updates_only, data: { action: "change->auto-submit#submit" })) %></label>
  <label class="flex items-center gap-1.5 text-xs"><%= t(".fixable_cves_html", submit: (check_box_tag :fixable, "1", @fixable_only, data: { action: "change->auto-submit#submit" })) %></label>
  <noscript><%= f.submit t(".filter"), class: "btn btn-secondary" %></noscript>
<% end %>

<%= search_results_frame do %>
<% if @repositories.any? %>
  <div class="card overflow-x-auto">
    <table id="docker-images" class="table-dense">
      <thead><tr><th class="pl-4">Image</th><th><%= t("words.tag") %></th><th><%= t(".servers") %></th><th><%= t("words.registry") %></th><th class="pr-4"><%= t(".vulnerabilities") %></th></tr></thead>
      <tbody>
        <% @repositories.each do |repository| %>
          <% repository.versions.each_with_index do |version, index| %>
            <tr class="docker-repository-version" data-repository="<%= repository.name %>">
              <td class="pl-4 font-mono text-xs"><%= repository.name if index.zero? %>
                <% if index.zero? && repository.versions.size > 1 %><span class="block font-sans text-[11px] text-warn-ink"><%= t(".versions_fleet_html", count: repository.versions.size) %></span><% end %></td>
              <td class="font-mono text-xs"><%= version.tag %></td>
              <td class="text-xs">
                <% if version.servers.any? %>
                  <%= safe_join(version.servers.first(4).map { |server| link_to(server.name, server_path(server, tab: "docker"), class: "hover:text-accent hover:underline") }, ", ") %><%= " …" if version.servers.size > 4 %>
                <% else %><span class="text-ink-3"><%= t(".container") %></span><% end %>
              </td>
              <td><%= image_update_badge(version.state) %></td>
              <td class="docker-version-cves pr-4 text-xs">
                <% if version.cves.positive? %>
                  <span class="inline-flex flex-wrap items-center gap-2"><%= severity_badge(version.severity) if version.severity %>
                    <span><%= tag.strong(version.cves, class: "text-ink") %> <%= t("words.including_fixable", count: version.fixable) %></span></span>
                <% else %><span class="text-ink-3">—</span><% end %>
              </td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= render "shared/pagination", pager: @pager, noun: t("nouns.images") %>
<% else %>
  <p class="card mt-3 px-4 py-6 text-sm text-ink-3"><%= @q.present? || @updates_only || @fixable_only ? t(".image_matches") : t(".known_docker_image") %></p>
<% end %>
<% end %>
