<% content_for :title, t("title", page: t("nav.keyring")) %>

<section id="keyring-section">
  <%= page_header t("nav.keyring"), subtitle: safe_join([ t(".subtitle"), " · ", t("count.keys", count: @pager.total) ]) do %>
    <% if can?(:operate) %>
      <%= link_to new_public_key_path, class: "btn btn-primary" do %><%= icon :plus %> <%= t(".add_key") %><% end %>
      <%= actions_menu do %>
        <%= menu_item t(".scan_keys"), server_scans_path, icon: :arrow_path, method: :post %>
      <% end %>
    <% end %>
  <% end %>

  <%# The last keys scan (by hand or planned): servers read, failures, keys outside the keyring. %>
  <% outside = @insights.outside_keys.size %>
  <% progress = @last_scan&.progress %>
  <% scan_item = if @last_scan.nil?
       { key: "last_scan", label: t(".last_scan"), tone: :neutral, text: (@last_read_at ? relative_time_in_words(@last_read_at) : t(".scan_never")) }
     elsif @last_scan.unfinished?
       { key: "last_scan", label: t(".last_scan"), tone: :neutral, text: t(".scan_running", done: progress[:done], count: progress[:total]) }
     else
       { key: "last_scan", label: t(".last_scan"), tone: (progress[:failed].positive? ? :warn : :good),
         text: [ t(".scan_read", done: progress[:total] - progress[:failed], count: progress[:total]), (t(".scan_failed", count: progress[:failed]) if progress[:failed].positive?) ].compact.join(" · ") }
     end %>
  <%= status_line [ scan_item, ({ key: "outside", label: t(".outside_keyring"), tone: (outside.positive? ? :warn : :good), text: t("count.keys", count: outside) } if @insights.scanned?) ].compact,
                  id: "keys-scan-summary", class: "mb-4" do %>
    <% if @last_scan %>
      <%= relative_time_tag(@last_scan.finished_at || @last_scan.created_at) %> · <%= link_to t(".see_task"), task_path(@last_scan), class: "text-accent hover:underline" %>
    <% end %>
  <% end %>

  <nav class="key-kind-filter filter-bar mb-3 flex flex-wrap gap-2" aria-label="<%= t(".key_type") %>">
    <% [ [ t(".all"), nil ], [ t(".people"), "person" ], [ t(".servers"), "server" ] ].each do |label, value| %>
      <%= filter_chip label, public_keys_path(kind: value), active: @kind == value %>
    <% end %>
    <%= filter_chip t("public_keys.outside.title"), public_keys_path(kind: "outside"), active: false, count: @insights.outside_keys.size.nonzero?, data: { kind: "outside" } %>
  </nav>

  <% if @public_keys.any? %>
    <div class="card overflow-x-auto">
      <table id="keyring" class="min-w-full divide-y divide-line text-sm">
        <thead class="bg-subtle text-left text-xs font-medium uppercase tracking-wide text-ink-3">
          <tr>
            <th scope="col" class="px-4 py-3"><%= t("words.name") %></th>
            <th scope="col" class="px-4 py-3">Type</th>
            <th scope="col" class="px-4 py-3"><%= t("words.algorithm") %></th>
            <th scope="col" class="px-4 py-3"><%= t("words.fingerprint") %></th>
            <th scope="col" class="px-4 py-3"><span class="sr-only"><%= t("words.actions") %></span></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line">
          <% @public_keys.each do |public_key| %>
            <tr id="<%= dom_id(public_key) %>" class="hover:bg-subtle">
              <td class="px-4 py-3">
                <%= link_to public_key.name, public_key_path(public_key), class: "font-medium hover:text-accent hover:underline" %>
                <%= weak_key_badge(public_key) %>
                <%= public_key_expiry_badge(public_key) %>
                <% if public_key.description %>
                  <p class="key-description text-xs text-ink-3"><%= public_key.description %></p>
                <% end %>
              </td>
              <td class="key-kind px-4 py-3 text-ink-2"><%= public_key.kind_label %></td>
              <td class="px-4 py-3 font-mono text-ink-2"><%= public_key.authorized_key&.type %></td>
              <td class="px-4 py-3 font-mono text-xs text-ink-3"><%= public_key.fingerprint %></td>
              <td class="px-4 py-3">
                <div class="flex items-center justify-end gap-1">
                  <% if can?(:operate) %>
                    <%= link_to edit_public_key_path(public_key),
                          title: t(".edit"), aria: { label: t(".edit_2", public_key_name: public_key.name) },
                          class: "rounded-md p-1.5 text-ink-3 hover:bg-subtle hover:text-ink-2" do %>
                      <%= icon :pencil_square %>
                    <% end %>
                  <% end %>
                  <% if can?(:operate) %>
                    <%= render "public_keys/delete_button", public_key: public_key %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= render "shared/pagination", pager: @pager, noun: t(".keys") %>
  <% else %>
    <div class="card">
      <%= empty_state t(".keyring_empty"), t(".keyring_empty_hint"), icon: :key do %>
        <% if can?(:operate) %><%= link_to t(".add_first_key"), new_public_key_path, class: "btn btn-primary" %><% end %>
      <% end %>
    </div>
  <% end %>
</section>
