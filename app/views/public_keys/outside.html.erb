<% content_for :title, t("title", page: t("public_keys.outside.title")) %>

<section id="keyring-section">
  <div class="flex items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold tracking-tight"><%= t("words.keyring") %></h1>
      <p class="text-sm text-ink-3"><%= t("public_keys.outside.intro") %></p>
    </div>
  </div>

  <nav class="key-kind-filter mt-4 flex flex-wrap gap-2" aria-label="<%= t("public_keys.index.key_type") %>">
    <% [ [ t("public_keys.index.all"), nil ], [ t("public_keys.index.people"), "person" ], [ t("public_keys.index.servers"), "server" ] ].each do |label, value| %>
      <%= filter_pill label, public_keys_path(kind: value), active: false %>
    <% end %>
    <%= filter_pill t("public_keys.outside.title"), public_keys_path(kind: "outside"), active: true, count: @pager.total.nonzero?, data: { kind: "outside" } %>
  </nav>

  <% if @outside_keys.any? %>
    <ul id="outside-keys" class="mt-4 divide-y divide-line rounded-xl border border-line bg-surface shadow-sm">
      <% @outside_keys.each do |entry| %>
        <% key = entry.key %>
        <li class="outside-key flex flex-wrap items-start gap-x-4 gap-y-2 px-4 py-3" data-fingerprint="<%= entry.fingerprint %>">
          <%= icon :key, class: "mt-0.5 h-4 w-4 shrink-0 text-warn-ink" %>
          <div class="min-w-0 flex-1">
            <p class="flex flex-wrap items-center gap-2 text-sm">
              <span class="key-name font-medium <%= key.named? ? "text-ink" : "italic text-ink-3" %>"><%= key.named? ? key.name : t("server_authorized_keys.index.unnamed") %></span>
              <% (entry.names - [ key.name ]).each do |other| %><span class="key-comment text-xs text-ink-3"><%= other %></span><% end %>
              <span class="font-mono text-xs text-ink-3"><%= key.type %></span>
            </p>
            <p class="key-fingerprint mt-0.5 break-all font-mono text-[11px] text-ink-3"><%= key.fingerprint %></p>
            <p class="key-places mt-1 text-xs text-ink-2">
              <%= t("public_keys.outside.on") %>
              <%= safe_join(entry.places.map { |server, unix_user, _| link_to("#{server.name} (#{unix_user})", server_path(server, tab: "keys"), class: "font-medium hover:text-accent hover:underline") }, ", ") %>
            </p>
          </div>
          <% if can?(:operate) %>
            <%= link_to new_public_key_path(content: [ key.type, key.key, key.comment ].compact.join(" "), name: suggested_public_key_name(key), return_to: public_keys_path(kind: "outside")),
                  class: "add-to-keyring inline-flex shrink-0 items-center gap-1.5 rounded-md border border-accent/40 bg-surface px-2.5 py-1 text-xs font-medium text-accent shadow-sm hover:bg-accent-soft" do %>
              <%= icon :user_plus, class: "h-4 w-4" %> <%= t("server_authorized_keys.index.add_keyring") %>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ul>
    <%= render "shared/pagination", pager: @pager, noun: t("nouns.keys") %>
  <% else %>
    <p class="outside-none mt-4 rounded-xl border border-dashed border-line px-6 py-10 text-center text-sm text-ink-3">
      <%= @insights.scanned? ? t("public_keys.outside.none") : t("public_keys.outside.not_scanned") %>
    </p>
  <% end %>
</section>
