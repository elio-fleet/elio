<% content_for :title, t("title", page: t("command_palette.add_key")) %>

<div class="max-w-4xl">
  <%= page_header t("command_palette.add_key"), crumbs: [ (@return_to ? [ t(".back_server").delete_prefix("← "), @return_to ] : [ t("nav.keyring"), public_keys_path ]), t("command_palette.add_key") ],
                  subtitle: (tag.span(t(".key_found_server_already"), class: "prefilled-hint") if @return_to && @public_key.content.present?) %>

  <div class="card p-5">
    <%= render "form", public_key: @public_key, return_to: @return_to %>
  </div>
</div>
