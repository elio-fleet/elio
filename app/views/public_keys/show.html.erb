<% content_for :title, "#{@public_key.name} · Elio" %>
<% key = @public_key.authorized_key %>

<div class="max-w-5xl">
  <% subtitle = safe_join([ tag.span(@public_key.kind_label, class: "key-kind font-medium text-ink-2"), " ", t(".added_keyring_html", created_at: relative_time_tag(@public_key.created_at)),
                            (tag.span(@public_key.description, class: "key-description block text-ink-2") if @public_key.description),
                            (tag.span(t(".owner", email: @public_key.user.email), class: "key-owner block text-ink-2") if @public_key.user) ].compact) %>
  <%= page_header @public_key.name, crumbs: [ [ t("nav.keyring"), public_keys_path ], @public_key.name ], subtitle: subtitle do %>
    <% if can?(:operate) %>
      <%= link_to edit_public_key_path(@public_key), class: "btn btn-secondary" do %><%= icon :pencil_square %> <%= t(".edit") %><% end %>
      <%= actions_menu do %>
        <%= menu_item t(".delete"), public_key_path(@public_key), icon: :trash, method: :delete, danger: true,
                      confirm: t("public_keys.delete_button.key_will_removed_keyring", public_key_name: @public_key.name), data: { confirm_label: t(".delete") } %>
      <% end %>
    <% end %>
  <% end %>

  <section id="keyring-key" class="card p-5">
    <h2 class="text-sm font-semibold"><%= t(".ssh_key") %></h2>

    <dl class="mt-4 grid grid-cols-1 gap-4 text-sm sm:grid-cols-3">
      <div>
        <dt class="font-medium text-ink-2">Type</dt>
        <dd class="mt-1 font-mono text-ink-2"><%= key.type %></dd>
      </div>
      <div class="sm:col-span-2">
        <dt class="font-medium text-ink-2"><%= t("words.fingerprint") %></dt>
        <dd id="keyring-fingerprint" class="mt-1 break-all font-mono text-ink-2"><%= @public_key.fingerprint %></dd>
      </div>
      <div class="sm:col-span-3">
        <dt class="font-medium text-ink-2"><%= t("words.comment") %></dt>
        <dd class="mt-1 text-ink-2"><%= key.comment || tag.span(t(".none"), class: "italic text-ink-3") %></dd>
      </div>
    </dl>

    <div class="mt-6" data-controller="clipboard">
      <div class="flex items-end justify-between gap-4">
        <label for="keyring-content" class="text-sm font-medium text-ink-2"><%= t(".public_key") %></label>
        <%= render "settings/copy_button" %>
      </div>
      <textarea id="keyring-content" readonly rows="3" data-clipboard-target="source"
                class="mt-2 block w-full resize-none rounded-md border border-line bg-subtle px-3 py-2 font-mono text-xs text-ink-2"><%= @public_key.content %></textarea>
    </div>
  </section>

  <%= render "public_keys/accesses", public_key: @public_key %>
  <% if can?(:operate) %>
    <%= render "public_keys/bulk_form", public_key: @public_key %>
  <% end %>
</div>
