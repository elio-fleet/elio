<%# The keys of one account of a server (Keys::AuthorizedKeysReader::AccountKeys). %>
<% account = entry.account %>
<% orphans = entry.keys.reject { |key| key.matches?(@app_key) || @public_keys_by_fingerprint.key?(key.fingerprint) } %>
<section class="authorized-keys-account" data-account="<%= account.unix_user %>">
  <% if show_header %>
    <h3 class="mb-2 flex flex-wrap items-center gap-2 text-sm font-medium">
      <%= icon :user, class: "h-4 w-4 text-ink-3" %><span class="font-mono"><%= account.unix_user %></span>
      <% if account.login? %><span class="account-login badge bg-accent-soft text-accent"><%= t(".login") %></span><% end %>
      <code class="rounded bg-subtle px-1 font-mono text-xs font-normal text-ink-3"><%= account.path %></code>
      <span class="text-xs font-normal text-ink-3">· <%= t("count.keys", count: entry.keys.size) %></span>
    </h3>
  <% end %>
  <% if entry.unreadable %>
    <p class="account-unreadable rounded-md border border-dashed border-line px-4 py-3 text-sm text-ink-3"><%= t(".unreadable") %></p>
  <% elsif entry.keys.empty? %>
    <p class="rounded-md border border-dashed border-line px-4 py-6 text-center text-sm text-ink-3"><%= t(account.login? ? "server_authorized_keys.index.authorized_key_server" : ".no_key") %></p>
  <% else %>
    <% if orphans.any? %>
      <div class="orphan-warning mb-3 flex gap-3 rounded-md border border-warn/40 bg-warn-soft px-4 py-3 text-sm text-warn-ink">
        <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-warn"></span>
        <p>
          <strong><%= t("server_authorized_keys.index.keyring_html", t: (t("count.keys_are_not", count: orphans.size))) %></strong>
          <%= t("server_authorized_keys.index.recognize", count: orphans.size) %>
        </p>
      </div>
    <% end %>
    <ul class="authorized-keys divide-y divide-line rounded-md border border-line">
      <% entry.keys.each do |key| %>
        <% orphan = orphans.include?(key) %>
        <% public_key = @public_keys_by_fingerprint[key.fingerprint] %>
        <li class="authorized-key flex items-center gap-3 px-4 py-3 <%= "is-orphan border-l-4 border-l-warn bg-warn-soft/40" if orphan %>">
          <%= icon :key, class: "h-4 w-4 shrink-0 text-ink-3" %>
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-2">
              <% if public_key %>
                <%= link_to public_key.name, public_key_path(public_key), data: { turbo_frame: "_top" },
                      class: "key-name key-keyring truncate text-sm font-medium text-ink hover:text-accent hover:underline" %>
                <span class="key-kind rounded-full bg-accent-soft px-2 py-0.5 text-xs font-medium text-accent ring-1 ring-inset ring-accent/20"><%= public_key.kind_label %></span>
                <% if key.named? && key.name != public_key.name %>
                  <span class="key-comment truncate text-xs text-ink-3"><%= key.name %></span>
                <% end %>
              <% else %>
                <span class="key-name truncate text-sm font-medium <%= key.named? ? "text-ink" : "italic text-ink-3" %>">
                  <%= key.named? ? key.name : t("server_authorized_keys.index.unnamed") %>
                </span>
                <% if orphan %>
                  <span class="key-badge key-unknown rounded-full bg-warn-soft px-2 py-0.5 text-xs font-medium text-warn-ink ring-1 ring-inset ring-warn/20"><%= t("server_authorized_keys.index.outside_keyring") %></span>
                <% end %>
              <% end %>
              <% if (access = @temporary_accesses[[ account.unix_user, key.fingerprint ]]) %>
                <%= relative_time_tag access.expires_at, prefix: t("public_keys.accesses.expires"), expired: t("public_keys.accesses.expired"),
                      class: "key-expiry inline-flex items-center rounded-full bg-warn-soft px-2 py-0.5 text-xs font-medium text-warn-ink ring-1 ring-inset ring-warn/20" %>
              <% end %>
              <% if key.matches?(@app_key) %>
                <span class="key-badge key-master rounded-full bg-accent-fill px-2 py-0.5 text-xs font-semibold text-white" title="<%= t("server_authorized_keys.index.ssh_key_elio_application") %>"><%= t("words.master") %></span>
              <% end %>
            </div>
          </div>
          <div data-controller="modal" class="shrink-0">
            <button type="button" data-action="modal#open" title="<%= t("server_authorized_keys.index.key_details") %>" aria-label="<%= t("server_authorized_keys.index.details_of", name: key.name || t("server_authorized_keys.index.unnamed_2")) %>"
                    class="key-details-button cursor-pointer rounded-md p-1.5 text-ink-3 hover:bg-subtle hover:text-ink-2">
              <%= icon :information_circle %>
            </button>
            <%= render "server_authorized_keys/key_details", key: key, account: account, public_key: public_key,
                                                             dialog_id: "key-#{account.unix_user.parameterize}-#{key.fingerprint.delete_prefix("SHA256:").gsub(/[^A-Za-z0-9]/, "")[0, 16]}" %>
          </div>
          <% if orphan %>
            <% if can?(:operate) %>
              <%= link_to new_public_key_path(content: [ key.type, key.key, key.comment ].compact.join(" "), name: suggested_public_key_name(key),
                                           return_to: server_path(@server, tab: "keys")),
                    data: { turbo_frame: "_top" },
                    class: "add-to-keyring inline-flex shrink-0 items-center gap-1.5 rounded-md border border-accent/40 bg-surface px-2.5 py-1 text-xs font-medium text-accent shadow-sm hover:bg-accent-soft" do %>
                <%= icon :user_plus, class: "h-4 w-4" %> <%= t("server_authorized_keys.index.add_keyring") %>
              <% end %>
            <% end %>
          <% end %>
          <% unless key.matches?(@app_key) %>
            <% if can?(:operate) %>
              <%= button_to server_authorized_key_path(@server), method: :delete,
                    params: { key: key.key, name: key.name, account: account.unix_user },
                    title: t("server_authorized_keys.index.delete_key"), aria: { label: t("server_authorized_keys.index.delete_key_2", nom: (key.name || t("server_authorized_keys.index.unnamed_2"))) },
                    form: { class: "shrink-0", data: { controller: "quiet-submit", turbo_frame: "_top",
                                                       turbo_confirm: t(account.login? ? "server_authorized_keys.index.key_will_deleted_will" : "server_authorized_keys.account.key_will_be_removed_from", nom: (key.name || t("server_authorized_keys.index.unnamed_2")), server_name: @server.name, account: account.unix_user),
                                                       confirm_label: t("server_authorized_keys.index.delete_key"), confirm_variant: "danger" } },
                    class: "cursor-pointer rounded-md p-1.5 text-ink-3 hover:bg-crit-soft hover:text-crit-ink disabled:cursor-wait disabled:opacity-50" do %>
                <%= icon :trash %>
              <% end %>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
