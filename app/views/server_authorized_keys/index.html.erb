<% content_for :title, t("title", page: t("server_authorized_keys.index.title", server_name: @server.name)) %>

<turbo-frame id="<%= dom_id(@server, :authorized_keys) %>" class="group block">
  <div class="flex items-center justify-between gap-4">
    <p class="text-sm text-ink-3">
      <% if @result.success? && @result.privileged %>
        <%= t(".accounts", count: @result.accounts.size) %> · <%= t("count.keys", count: @result.keys.size) %>
      <% elsif @result.success? %>
        <code class="rounded bg-subtle px-1 font-mono text-xs"><%= @result.login.account.path %></code>
        · <%= t("count.keys", count: @result.keys.size) %>
      <% end %>
    </p>
    <%= link_to server_authorized_keys_path(@server),
          title: t(".reload_keys"), aria: { label: t(".reload_keys") },
          class: "rounded-md border border-line bg-surface p-2 text-ink-2 shadow-sm hover:bg-subtle" do %>
      <%= icon :arrow_path, class: "h-4 w-4 group-aria-busy:animate-spin" %>
    <% end %>
  </div>


  <div class="mt-4 space-y-6 group-aria-busy:opacity-50">
    <% if !@result.success? %>
      <div class="authorized-keys-error flex gap-3 rounded-md border border-crit/40 bg-crit-soft px-4 py-3 text-sm text-crit-ink">
        <%= icon :x_mark, class: "mt-0.5 h-4 w-4 shrink-0" %>
        <div>
          <p class="font-medium"><%= @result.error_title %></p>
          <p class="mt-1 break-all font-mono text-xs text-crit-ink"><%= @result.error_details %></p>
        </div>
      </div>
      <% if @result.reason %>
        <%= render "ssh_keys/setup_hint", server: @server, reason: @result.reason %>
      <% end %>
      <%= link_to t(".try_again"), server_authorized_keys_path(@server),
            class: "btn btn-secondary retry-authorized-keys mt-3" %>
    <% else %>
      <% @result.accounts.each do |entry| %>
        <%= render "server_authorized_keys/account", entry: entry, show_header: @result.privileged %>
      <% end %>
      <% unless @result.privileged %>
        <p class="accounts-root-needed text-xs text-ink-3"><%= t(".root_needed", login: @server.username) %></p>
      <% end %>
    <% end %>
  </div>
</turbo-frame>
