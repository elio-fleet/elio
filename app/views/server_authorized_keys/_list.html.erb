
<%# The key list of a server (the frame's content), from @result: a Keys::AuthorizedKeysReader.call_all
    read, made by the index or on the connection of a change (AuthorizedKeysRefresh). %>
<turbo-frame id="<%= dom_id(@server, :authorized_keys) %>" class="group block">
  <div class="flex items-center justify-between gap-4">
    <p class="text-sm text-ink-3">
      <% if @result.success? && @result.privileged %>
        <%= t("server_authorized_keys.index.accounts", count: @result.accounts.size) %> · <%= t("count.keys", count: @result.keys.size) %>
      <% elsif @result.success? %>
        <code class="rounded bg-subtle px-1 font-mono text-xs"><%= @result.login.account.path %></code>
        · <%= t("count.keys", count: @result.keys.size) %>
      <% end %>
    </p>
    <%= link_to server_authorized_keys_path(@server),
          title: t("server_authorized_keys.index.reload_keys"), aria: { label: t("server_authorized_keys.index.reload_keys") },
          class: "rounded-md border border-line bg-surface p-2 text-ink-2 shadow-sm hover:bg-subtle" do %>
      <%= icon :arrow_path, class: "h-4 w-4 group-aria-busy:animate-spin" %>
    <% end %>
  </div>


  <div class="mt-4 space-y-6 group-aria-busy:opacity-50">
    <% if !@result.success? %>
      <div class="authorized-keys-error flex gap-3 rounded-md border border-crit/40 bg-crit-soft px-4 py-3 text-sm text-crit-ink">
        <%= icon :x_mark, class: "mt-0.5 h-4 w-4 shrink-0" %>
        <div>
          <p class="font-medium"><%= @result.error_title %></p>
          <p class="mt-1 break-all font-mono text-xs text-crit-ink"><%= @result.error_details %></p>
        </div>
      </div>
      <% if @result.reason %>
        <%= render "ssh_keys/setup_hint", server: @server, reason: @result.reason %>
      <% end %>
      <%= link_to t("server_authorized_keys.index.try_again"), server_authorized_keys_path(@server),
            class: "btn btn-secondary retry-authorized-keys mt-3" %>
    <% else %>
      <% @result.accounts.each do |entry| %>
        <%= render "server_authorized_keys/account", entry: entry, show_header: @result.privileged %>
      <% end %>
      <% if @result.dormant.any? %>
        <section class="dormant-accounts text-sm">
          <h3 class="mb-1 flex items-center gap-2 font-medium">
            <%= icon :user, class: "h-4 w-4 text-ink-3" %><%= t(".dormant", count: @result.dormant.size) %>
          </h3>
          <p class="text-xs text-ink-3"><%= t(".dormant_hint") %></p>
          <p class="mt-2 flex flex-wrap gap-1.5">
            <% @result.dormant.each do |user| %>
              <span class="dormant-account rounded bg-subtle px-1.5 py-0.5 font-mono text-xs text-ink-2"><%= user %></span>
            <% end %>
          </p>
        </section>
      <% end %>
      <% unless @result.privileged || @server.username == "root" %>
        <p class="accounts-root-needed text-xs text-ink-3"><%= t("server_authorized_keys.index.root_needed", login: @server.username) %></p>
      <% end %>
    <% end %>
  </div>
</turbo-frame>
