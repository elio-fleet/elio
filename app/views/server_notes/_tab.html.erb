<%# Notes tab of a server page (ServerNotesController). %>
<section id="server-notes" class="card mt-6">
  <div class="card-header">
    <div>
      <h2 class="flex items-center gap-2 font-semibold"><%= icon :pencil_square, class: "h-4 w-4 text-ink-3" %> <%= t("server_notes.tab.title") %></h2>
      <p class="mt-0.5 text-xs text-ink-3"><%= t("server_notes.tab.intro") %></p>
    </div>
  </div>
  <div class="border-b border-line px-4 py-4">
    <%= render "server_notes/form", server: server, note: server.notes.new %>
  </div>
  <% if notes.any? %>
    <ul class="server-notes divide-y divide-line">
      <% notes.each do |note| %>
        <li><%= render "server_notes/note", server: server, note: note %></li>
      <% end %>
    </ul>
    <% if pager.multiple_pages? %><div class="px-4 pb-3"><%= render "shared/pagination", pager: pager, noun: t("server_notes.tab.title").downcase %></div><% end %>
  <% else %>
    <p class="server-notes-none px-4 py-6 text-sm text-ink-3"><%= t("server_notes.tab.none") %></p>
  <% end %>
</section>
