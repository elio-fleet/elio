<%# A menu button: render "shared/dropdown", label: "Actions", id: "fleet-actions" do … end.
    Items: links or button_to with role: "menuitem" and class "dropdown-item". %>
<details id="<%= local_assigns[:id] %>" class="dropdown relative <%= local_assigns[:class] %>"
         data-controller="dropdown" data-action="keydown->dropdown#keydown">
  <summary class="btn btn-secondary list-none cursor-pointer [&::-webkit-details-marker]:hidden" aria-haspopup="menu">
    <% if local_assigns[:icon] %><%= icon local_assigns[:icon], class: "h-4 w-4" %><% end %>
    <%= label %>
    <%= icon :chevron_down, class: "h-4 w-4 text-ink-3" %>
  </summary>
  <div role="menu" aria-label="<%= label %>" data-action="click->dropdown#chosen"
       class="dropdown-menu absolute right-0 z-30 mt-1 w-64 overflow-hidden rounded-lg border border-line bg-surface py-1 shadow-lg">
    <%= yield %>
  </div>
</details>
