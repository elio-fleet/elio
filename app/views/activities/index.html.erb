<% content_for :title, t("title", page: t("nav.journal")) %>

<% subtitle = safe_join([ (@server ? t(".history_on", server_name: @server.name) : t(".history")), ".",
                          (safe_join([ " ", link_to(t(".see_all"), activities_path(category: @category), class: "font-medium text-accent hover:underline") ]) if @server) ].compact) %>
<%= page_header t("nav.journal"), subtitle: subtitle %>

<%= render "activities/journal_tabs", current: "events" %>

<div class="filter-bar mb-3 flex flex-wrap items-center gap-2">
<nav class="activity-filters flex flex-wrap items-center gap-2" aria-label="<%= t(".categories") %>">
  <% [ [ t(".all"), nil ], *Activity::CATEGORIES.map { |key| [ Activity.category_label(key), key.to_s ] } ].each do |label, category| %>
    <%= filter_chip label, activities_path(category: category, server_id: @server&.id, **@search.to_params), active: @category == category %>
  <% end %>
  <% if @kind %>
    <span class="activity-kind-filter inline-flex items-center gap-1 rounded-full border border-ink bg-ink px-3 py-1 text-sm text-surface">
      <%= Activity::KINDS.fetch(@kind.to_sym).label %>
      <%= link_to activities_path(category: @category, server_id: @server&.id, **@search.to_params), aria: { label: t(".remove_kind_filter") }, class: "opacity-70 hover:opacity-100" do %><%= icon :x_mark, class: "h-3.5 w-3.5" %><% end %>
    </span>
  <% end %>
</nav>
<%= render "activities/journal_search", search: @search, url: activities_path, hidden: { category: @category, server_id: @server&.id, kind: @kind } %>
</div>

<%= search_results_frame do %>
<% if @search.any? %><p class="journal-search-count mb-2 text-xs text-ink-3"><%= t("activities.journal_search.count", count: @pager.total) %></p><% end %>
<section class="card px-4">
  <% if @activities.any? %>
    <ul id="activities" class="divide-y divide-line">
      <%= render partial: "activities/activity", collection: @activities %>
    </ul>
  <% else %>
    <p class="py-10 text-center text-sm text-ink-3"><%= @search.any? ? t("activities.journal_search.nothing") : t(".activity_yet") %></p>
  <% end %>
</section>

<%= render "shared/pagination", pager: @pager, noun: t(".activities") %>
<% end %>
