<%# One event of the Journal: severity, summary, kind, author, time (its permanent link), server. Locals: activity, show_server (default true), repeats (optional: the same event happened again just before, most recent first). %>
<% repeats = local_assigns.fetch(:repeats, []) %>
<li id="<%= dom_id(activity) %>" class="activity flex items-start gap-3 py-3 text-sm" data-kind="<%= activity.kind %>">
  <span class="mt-1.5"><%= render "activities/severity", severity: activity.severity %></span>
  <div class="min-w-0 flex-1">
    <p class="text-ink"><%= activity.summary %>
      <% if repeats.any? %><span class="activity-repeats ml-1 rounded-full bg-subtle px-1.5 text-xs tabular-nums text-ink-2" title="<%= t("activities.activity.repeated", count: repeats.size + 1) %>">× <%= repeats.size + 1 %></span><% end %>
    </p>
    <p class="mt-0.5 text-xs text-ink-3">
      <span class="font-medium text-ink-2"><%= activity.label %></span>
      · <%= activity.author_name %>
      · <%= link_to activity_path(activity), class: "activity-permalink hover:text-accent hover:underline", data: { turbo_frame: "_top" } do %><%= relative_time_tag activity.created_at %><% end %>
      <% if activity.server && local_assigns.fetch(:show_server, true) %>
        · <%= link_to activity.server.name, server_path(activity.server), class: "hover:text-accent hover:underline", data: { turbo_frame: "_top" } %>
      <% end %>
    </p>
    <% if repeats.any? %>
      <details class="activity-repeat-list mt-1 text-xs text-ink-3">
        <summary class="cursor-pointer hover:text-ink-2"><%= t("activities.activity.earlier", count: repeats.size) %></summary>
        <ul class="mt-1 flex flex-wrap gap-x-3 gap-y-1">
          <% repeats.each do |repeat| %>
            <li><%= link_to activity_path(repeat), id: dom_id(repeat), class: "hover:text-accent hover:underline", data: { turbo_frame: "_top" } do %><%= l(repeat.created_at, format: :short) %><% end %></li>
          <% end %>
        </ul>
      </details>
    <% end %>
  </div>
</li>
