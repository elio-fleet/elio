<% content_for :title, t("title", page: t("integrations.technitium.tab")) %>

<div class="flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 class="text-xl font-semibold"><%= t("technitium_records.index.title") %></h1>
    <p class="text-xs text-ink-3">
      <%= t("technitium_records.index.intro") %><% if @integration.last_synced_at %> <%= t("technitium_records.index.synchronized_html", time: relative_time_tag(@integration.last_synced_at)) %><% end %>.
      <% if @integration.last_error %><span class="text-crit-ink"><%= t("technitium_records.index.last_sync_failed", error: @integration.last_error) %></span><% end %>
    </p>
  </div>
  <% if can?(:administer) %>
    <%= link_to edit_settings_integration_path(@integration.kind), class: "btn btn-secondary" do %><%= icon :cog, class: "h-4 w-4" %><%= t("technitium_records.index.extension") %><% end %>
  <% end %>
</div>

<div class="mt-5 grid grid-cols-2 gap-3 lg:grid-cols-4">
  <%= stat_tile t("technitium_records.index.records"), @counts[:total], nil, icon: :globe, id: "stat-dns-records" %>
  <%= stat_tile t("technitium_records.index.outside"), @counts[:outside], t("technitium_records.index.outside_caption"), tone: (:warn if @counts[:outside].positive?), id: "stat-dns-outside" %>
  <%= stat_tile t("technitium_records.index.unattached"), @counts[:unattached], nil, id: "stat-dns-unattached" %>
  <%= stat_tile t("technitium_records.index.servers_without"), @counts[:servers_without], nil, icon: :server_stack, id: "stat-dns-servers-without" %>
</div>

<div class="mt-5 flex flex-wrap items-center gap-2">
  <nav class="dns-filters flex flex-wrap gap-2" aria-label="<%= t("technitium_records.index.filters") %>">
    <% [ [ t("technitium_records.index.all"), nil ], [ t("technitium_records.index.outside"), "outside" ], [ t("technitium_records.index.unattached"), "unattached" ] ].each do |label, filter| %>
      <%= filter_pill label, technitium_records_path(filter: filter, zone: @zone), active: @filter == filter, data: { filter: filter || "all" } %>
    <% end %>
  </nav>
  <%= form_with url: technitium_records_path, method: :get, data: search_form_data, class: "ml-auto flex flex-wrap items-center gap-2" do |f| %>
    <%= hidden_field_tag :filter, @filter if @filter %>
    <% if @zones.size > 1 %>
      <%= f.select :zone, [ [ t("technitium_records.index.all_zones"), "" ], *@zones.map { |zone| [ zone, zone ] } ], { selected: @zone },
            aria: { label: t("technitium_records.index.zone") }, data: { action: "change->auto-submit#submit" }, class: "input w-auto py-1 text-xs" %>
    <% end %>
    <%= f.search_field :q, value: @q, placeholder: t("technitium_records.index.search"), aria: { label: t("technitium_records.index.search") },
          data: { action: "input->auto-submit#submitLater" }, class: "input w-56 py-1 text-xs" %>
  <% end %>
</div>

<%= search_results_frame do %>
  <% if @records.any? %>
    <div class="card mt-3 overflow-x-auto">
      <table id="dns-records" class="table-dense">
        <thead><tr><th class="pl-4"><%= t("technitium_records.index.name") %></th><th>Type</th><th><%= t("technitium_records.index.value") %></th><th><%= t("technitium_records.index.server") %></th><% if can?(:operate) %><th class="pr-4 text-right"><%= t("technitium_records.index.attach") %></th><% end %></tr></thead>
        <tbody>
          <% @records.each do |record| %>
            <tr class="dns-record" data-name="<%= record.name %>" data-type="<%= record.record_type %>">
              <td class="pl-4 font-mono text-xs"><%= record.name %><% if record.disabled %> <span class="badge bg-subtle text-ink-3"><%= t("technitium_records.index.disabled") %></span><% end %>
                <span class="block font-sans text-[11px] text-ink-3"><%= record.zone %></span></td>
              <td class="font-mono text-xs"><%= record.record_type %></td>
              <td class="font-mono text-xs"><%= record.value %></td>
              <td class="text-xs">
                <% if record.server %>
                  <%= link_to record.server.name, server_path(record.server, tab: "dns"), class: "font-medium hover:text-accent hover:underline" %>
                  <span class="block text-[11px] text-ink-3"><%= record.matched_label %></span>
                <% elsif record.address? %>
                  <%= status_badge :warn, t("technitium_records.index.outside_fleet"), class: "dns-outside" %>
                <% else %>
                  <span class="text-ink-3">—</span>
                <% end %>
              </td>
              <% if can?(:operate) %><td class="pr-4"><%= render "integrations/technitium/link_form", record: record %></td><% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= render "shared/pagination", pager: @pager, noun: t("technitium_records.index.records").downcase %>
  <% else %>
    <p class="card mt-3 px-4 py-6 text-sm text-ink-3"><%= @integration.last_synced_at ? t("technitium_records.index.none") : t("technitium_records.index.not_synchronized") %></p>
  <% end %>
<% end %>
