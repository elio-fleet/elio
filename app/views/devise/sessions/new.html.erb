<% content_for :title, t("title", page: t("auth.sign_in.title")) %>

<h2 class="mb-5 text-base font-semibold"><%= t("auth.sign_in.title") %></h2>

<%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-5" }) do |f| %>
  <div>
    <%= f.label :email, t("auth.fields.email"), class: "label" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true,
          class: "input mt-1" %>
  </div>

  <div>
    <%= f.label :password, t("auth.fields.password"), class: "label" %>
    <%= f.password_field :password, autocomplete: "current-password", required: true,
          class: "input mt-1" %>
  </div>

  <% if devise_mapping.rememberable? %>
    <div class="flex items-center gap-2">
      <%= f.check_box :remember_me, class: "h-4 w-4 rounded border-line text-accent" %>
      <%= f.label :remember_me, t("auth.sign_in.remember_me"), class: "text-sm text-ink-2" %>
    </div>
  <% end %>

  <%= f.submit t("auth.sign_in.submit"),
        class: "btn btn-primary w-full" %>
<% end %>

<% if Rails.configuration.x.mail_enabled %>
  <p class="mt-4 text-center text-sm"><%= link_to t("auth.sign_in.forgot"), new_password_path(resource_name), class: "forgot-password text-accent hover:underline" %></p>
<% end %>

<p class="mt-6 text-center text-sm text-ink-3">
  <%= t("auth.sign_in.no_account") %>
</p>
