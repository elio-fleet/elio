<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="h-full">
  <head>
    <title><%= content_for(:title) || "Elio" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%# The system tests: no request started by a mouse hover, that could end after the test (and set the session again). %>
    <% if Rails.env.test? %><meta name="turbo-prefetch" content="false"><% end %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= render "layouts/theme_script" %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="flex min-h-full flex-col items-center justify-center bg-canvas px-4 py-12 font-sans text-sm text-ink antialiased">
    <%= render "shared/flash_container" %>
    <div class="w-full max-w-sm">
      <h1 class="mb-6 flex items-center justify-center gap-2.5 text-2xl font-semibold tracking-tight">
        <span class="grid h-9 w-9 place-items-center rounded-xl bg-accent-fill text-white"><%= icon :server_stack, class: "h-5 w-5" %></span>Elio
      </h1>
      <div class="card p-6">
        <%= yield %>
      </div>
      <p class="mt-4 text-center text-xs text-ink-3"><%= t("layouts.auth.tagline", version: Elio::VERSION) %></p>
    </div>
    <%= js_translations_tag %>
  </body>
</html>
