<%# Sidebar of the signed-in pages (direction A): always visible from `lg`, a drawer below (sidebar_controller.js). %>
<% settings_active = controller_path.start_with?("settings") %>
<div data-sidebar-target="backdrop" data-action="click->sidebar#close" class="fixed inset-0 z-30 hidden bg-black/40 lg:hidden"></div>
<aside data-sidebar-target="panel"
       class="sidebar fixed inset-y-0 left-0 z-40 flex w-60 -translate-x-full flex-col border-r border-line bg-surface overflow-y-auto px-3 py-4 transition-transform lg:translate-x-0">
  <div class="flex items-center justify-between">
    <%= link_to root_path, class: "flex items-center gap-2 px-1 text-base font-semibold tracking-tight text-ink" do %>
      <span class="grid h-7 w-7 place-items-center rounded-lg bg-accent-fill text-white"><%= icon :server_stack, class: "h-4 w-4" %></span>
      Elio
    <% end %>
    <button type="button" data-action="sidebar#close" aria-label="<%= t(".close_menu") %>" class="btn btn-ghost btn-icon lg:hidden"><%= icon :x_mark %></button>
  </div>

  <%= render "shared/command_palette_button" %>

  <% counts = SidebarCounts.new %>
  <nav class="main-nav mt-4" aria-label="<%= t(".main_navigation") %>">
    <div class="space-y-0.5">
      <%= sidebar_link t("nav.overview"), root_path, icon: :squares_2x2, active: controller_name == "dashboard" %>
      <%= sidebar_link t("nav.fleet"), servers_path, icon: :server_stack, count: counts.servers.value,
                       active: controller_name.start_with?("server") %>
    </div>
    <%= sidebar_section t(".fleet_wide") %>
    <div class="space-y-0.5">
      <%= sidebar_link t("nav.vulnerabilities"), vulnerabilities_path, icon: :shield_exclamation, count: counts.vulnerabilities,
                       active: controller_name == "vulnerabilities" && !controller_path.start_with?("settings") %>
      <%= sidebar_link t("nav.packages"), packages_path, icon: :arrow_up_circle, active: controller_name == "packages" %>
      <%= sidebar_link t("nav.docker"), docker_path, icon: :docker, count: counts.docker, active: controller_path == "docker" %>
      <%= sidebar_link t("nav.ports"), ports_path, icon: :arrows_right_left, active: controller_name == "ports" %>
      <%= sidebar_link t("nav.scheduled_tasks"), scheduled_tasks_path, icon: :calendar, count: counts.scheduled_tasks, active: controller_name == "scheduled_tasks" %>
    </div>
    <%= sidebar_section t(".access") %>
    <div class="space-y-0.5">
      <%= sidebar_link t("nav.keyring"), public_keys_path, icon: :key, active: controller_name == "public_keys" %>
    </div>
    <% if (links = Integration.sidebar_links).any? %>
      <%= sidebar_section t(".extensions") %>
      <div class="space-y-0.5">
        <% links.each do |link| %>
          <%= sidebar_link link[:label], public_send(link[:path]), icon: link[:icon], active: controller_path == link[:controller], data: { integration_link: true } %>
        <% end %>
      </div>
    <% end %>
    <div class="mt-4 space-y-0.5 border-t border-line pt-3">
      <%= sidebar_link t("nav.journal"), activities_path, icon: :document_text, count: counts.running_tasks,
                       active: controller_name.in?(%w[activities tasks]), id: "sidebar-tasks", title: t("nav.tasks_title") %>
      <% if can?(:administer) %>
        <%= sidebar_link t("nav.settings"), settings_path, icon: :cog, active: settings_active, title: t("nav.settings") %>
      <% end %>
    </div>
  </nav>

  <div class="mt-auto space-y-1 border-t border-line pt-3">
    <%= link_to account_path, title: t("nav.account"), aria: { current: (controller_name == "accounts" ? "page" : nil) },
          class: "account-link flex items-center gap-2 rounded-lg px-2.5 py-1.5 hover:bg-subtle" do %>
      <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-subtle text-xs font-semibold text-ink-2"><%= current_user.email.first(2).upcase %></span>
      <span class="min-w-0 leading-tight">
        <span class="block truncate text-xs font-medium text-ink"><%= current_user.email %></span>
        <span class="user-role text-[11px] text-ink-3"><%= current_user.role_label %></span>
      </span>
    <% end %>
    <div class="flex items-center gap-1">
      <button type="button" data-controller="theme" data-action="theme#toggle" aria-pressed="false"
              class="theme-toggle btn btn-ghost flex-1 justify-start px-2.5 text-xs">
        <%= icon :moon, class: "h-4 w-4 dark:hidden" %><%= icon :sun, class: "hidden h-4 w-4 dark:block" %>
        <span data-theme-target="label"><%= t(".dark_theme") %></span>
      </button>
      <%= button_to destroy_user_session_path, method: :delete, title: t(".sign_out"), aria: { label: t(".sign_out") },
            class: "btn btn-ghost btn-icon" do %>
        <%= icon :logout %><span class="sr-only"><%= t(".sign_out") %></span>
      <% end %>
    </div>
    <%= link_to "Elio #{Elio::VERSION}", "https://github.com/elio-fleet/elio/releases", target: "_blank", rel: "noopener",
          class: "elio-version block px-2.5 pt-1 text-[11px] text-ink-3 hover:text-ink" %>
  </div>
</aside>
