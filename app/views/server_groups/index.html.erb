<% content_for :title, t("title", page: t("nav.server_groups")) %>

<section id="server-groups-section">
  <%= page_header t("nav.server_groups"), subtitle: t("count.groups", count: @groups.size), crumbs: [ [ t("nav.fleet"), servers_path ], t("nav.server_groups") ] do %>
    <% if can?(:operate) %>
      <%= link_to new_server_group_path, class: "btn btn-primary" do %><%= icon :plus %> <%= t(".new_group") %><% end %>
    <% end %>
  <% end %>

  <% if @groups.any? %>
    <ul id="server-groups" class="card divide-y divide-line">
      <% @groups.each do |group| %>
        <li id="<%= dom_id(group) %>" class="server-group flex items-center gap-4 px-4 py-3">
          <span class="h-3 w-3 shrink-0 rounded-full <%= group.dot_classes %>"></span>
          <div class="min-w-0 flex-1">
            <%= link_to group.name, servers_path(group: group.id), class: "font-medium hover:text-accent hover:underline" %>
            <p class="truncate text-xs text-ink-3">
              <% if group.servers.any? %>
                <%= t("words.label_value", label: t("count.servers", count: group.servers.size), value: group.servers.map(&:name).join(", ")) %>
              <% else %>
                <%= t(".server") %>
              <% end %>
            </p>
          </div>
          <% if can?(:operate) %>
            <%= link_to edit_server_group_path(group), title: t(".edit"), aria: { label: t(".edit_group", group_name: group.name) }, class: "btn btn-ghost btn-icon" do %>
              <%= icon :pencil_square %>
            <% end %>
            <%= actions_menu label: t(".group_actions", group_name: group.name) do %>
              <%= menu_item t(".delete_group_2"), server_group_path(group), icon: :trash, method: :delete, danger: true,
                            confirm: t(".group_will_deleted_servers", group_name: group.name), data: { confirm_label: t(".delete_group_2") } %>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="card">
      <%= empty_state t(".no_group"), t(".group_groups_filter_servers"), icon: :list_bullet do %>
        <% if can?(:operate) %><%= link_to t(".create_group"), new_server_group_path, class: "btn btn-primary" %><% end %>
      <% end %>
    </div>
  <% end %>
</section>
