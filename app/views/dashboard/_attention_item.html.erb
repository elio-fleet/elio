<%# One line of the "To do" list of the overview (AttentionList::Item). Locals: item. %>
<li class="attention-item flex items-center gap-3 px-4 py-2.5" data-tone="<%= item.tone %>">
  <span class="<%= { "crit" => "text-crit-ink", "warn" => "text-warn-ink", "info" => "text-ink-3" }.fetch(item.tone) %>"><%= icon item.icon %></span>
  <p class="min-w-0 flex-1 truncate"><span class="font-medium"><%= item.subject %></span> <span class="text-ink-2">— <%= item.text %></span></p>
  <%= link_to item.action, item.path, class: "btn btn-secondary py-1 text-xs" %>
</li>
