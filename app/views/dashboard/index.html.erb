<% content_for :title, t("title", page: t("nav.overview")) %>

<div class="flex flex-wrap items-start justify-between gap-4">
  <div>
    <h1 class="text-xl font-semibold"><%= t("nav.overview") %></h1>
    <p class="text-xs text-ink-3">
      <%= t("count.servers", count: @summary.total) %>
      <% if @summary.last_inventory_at %> <%= t(".inventory_html", last_inventory_at: relative_time_tag(@summary.last_inventory_at)) %><% end %>
    </p>
  </div>
  <% if can?(:operate) && @servers.any? %>
    <div class="flex flex-wrap gap-2">
      <%= button_to server_inventories_path, class: "btn btn-secondary" do %><%= icon :pulse %> <%= t("words.inventory") %><% end %>
      <%= button_to server_scans_path, class: "btn btn-secondary" do %><%= icon :key %> <%= t(".scan_keys") %><% end %>
    </div>
  <% end %>
</div>

<% if can?(:operate) && !@checklist.complete? %>
  <%= render "dashboard/checklist", checklist: @checklist %>
<% end %>

<div class="fleet-summary mt-5 grid grid-cols-2 gap-3 lg:grid-cols-4">
  <%= stat_tile t(".online"), "#{@summary.online}/#{@summary.total}", t(".answer_their_ssh_port"), tone: (:good if @summary.total.positive? && @summary.online == @summary.total), icon: :check, id: "stat-online" %>
  <%= stat_tile t(".watch"), @summary.to_watch, t(".reboot_disk_service"), tone: (:warn if @summary.to_watch.positive?), icon: :exclamation_triangle, id: "stat-to-watch" %>
  <%= stat_tile t(".critical"), @summary.critical, (@summary.unreachable.positive? ? t(".including_unreachable", count: @summary.unreachable) : t(".critical_thresholds_exceeded")),
                tone: (:crit if @summary.critical.positive?), icon: :x_mark, id: "stat-critical" %>
  <%= stat_tile t(".unknown_keys"), (@insights.scanned? ? @insights.orphan_count : "—"), (@insights.scanned? ? t(".outside_keyring") : t(".run_key_scan")),
                tone: (:warn if @insights.orphan_count.positive?), icon: :key, id: "stat-orphans" %>
</div>

<div class="mt-5 grid gap-5 lg:grid-cols-3">
  <div class="min-w-0 space-y-5 lg:col-span-2">
    <section id="attention" class="card">
      <div class="card-header">
        <h2 class="font-semibold"><%= t(".do") %></h2>
        <span class="text-xs text-ink-3"><%= @attention.any? ? t(".items_by_severity", count: @attention.size) : "" %></span>
      </div>
      <% if @attention.any? %>
        <% if @attention.items.any? %>
          <ul class="divide-y divide-line"><%= render partial: "dashboard/attention_item", collection: @attention.items, as: :item %></ul>
        <% end %>
        <% if @attention.docker_items.any? %>
          <h3 class="attention-docker flex items-center gap-1.5 border-t border-line px-4 pt-3 pb-1 text-xs font-semibold tracking-wide text-ink-3 uppercase"><%= icon :docker, class: "h-4 w-4" %>Docker</h3>
          <ul class="attention-docker-items divide-y divide-line"><%= render partial: "dashboard/attention_item", collection: @attention.docker_items, as: :item %></ul>
        <% end %>
      <% else %>
        <p class="attention-empty flex items-center gap-2 px-4 py-4 text-sm text-good-ink"><%= icon :check_circle %>
          <%= @servers.any? ? t(".nothing_report_servers_reachable") : t(".add_first_server_begin") %></p>
      <% end %>
    </section>

    <section id="recent-activity" class="card px-4 pt-3 pb-1">
      <div class="flex items-center justify-between">
        <h2 class="font-semibold"><%= t(".recent_activity") %></h2>
        <%= link_to t(".see_all"), activities_path, class: "text-xs font-medium text-accent hover:underline" %>
      </div>
      <% if @activities.any? %>
        <ul class="mt-1 divide-y divide-line"><%= render partial: "activities/activity", collection: @activities %></ul>
      <% else %>
        <p class="py-4 text-sm text-ink-3"><%= t(".activity_yet") %></p>
      <% end %>
    </section>
  </div>

  <div class="min-w-0 space-y-5">
    <section id="temporary-accesses" class="card">
      <div class="card-header"><h2 class="font-semibold"><%= t(".temporary_access") %></h2><span class="text-xs text-ink-3"><%= t(".ongoing_html", count: @temporary_accesses.size) %></span></div>
      <% if @temporary_accesses.any? %>
        <ul class="divide-y divide-line">
          <% @temporary_accesses.each do |access| %>
            <li class="temporary-access px-4 py-2.5 text-sm">
              <p class="truncate font-medium"><%= access.public_key&.name || t(".key_deleted") %></p>
              <p class="text-xs text-ink-3">
                <%= link_to access.server.name, server_path(access.server, tab: "keys"), class: "hover:underline" %> ·
                <span class="font-mono"><%= access.unix_user %></span> ·
                <%= relative_time_tag access.expires_at, prefix: "expire ", expired: t(".expired_being_removed") %>
              </p>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="px-4 py-3 text-xs text-ink-3"><%= t(".temporary_access_choose_duration") %></p>
      <% end %>
    </section>

    <section id="systems" class="card">
      <div class="card-header"><h2 class="font-semibold"><%= t(".systems") %></h2><span class="text-xs text-ink-3"><%= t("count.servers", count: @systems.sum(&:last)) %></span></div>
      <% if @systems.any? %>
        <ul class="divide-y divide-line px-4 text-sm">
          <% @systems.each do |name, count| %>
            <li class="flex justify-between gap-3 py-2"><%= link_to name, servers_path(os: name), class: "truncate text-ink-2 hover:text-ink" %><span class="tabular-nums"><%= count %></span></li>
          <% end %>
        </ul>
      <% else %>
        <p class="px-4 py-3 text-xs text-ink-3"><%= t(".systems_will_appear_after") %></p>
      <% end %>
    </section>
  </div>
</div>
