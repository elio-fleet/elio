<% content_for :title, t("title", page: t("nav.overview")) %>

<% if @servers.empty? %>
  <%= page_header t(".welcome"), subtitle: t(".welcome_subtitle") %>
  <% if can?(:operate) %>
    <%= render "dashboard/checklist", checklist: @checklist %>
  <% else %>
    <%= panel nil do %><%= empty_state t(".no_server"), t(".no_server_viewer"), icon: :server_stack %><% end %>
  <% end %>
<% else %>
  <%= page_header t("nav.overview"),
                  subtitle: safe_join([ t("count.servers", count: @summary.total), (t(".inventory_html", last_inventory_at: relative_time_tag(@summary.last_inventory_at)) if @summary.last_inventory_at) ].compact, " ") do %>
    <% if can?(:operate) %>
      <%= button_to server_inventories_path, class: "btn btn-secondary" do %><%= icon :arrow_path %> <%= t(".refresh_fleet") %><% end %>
      <%= actions_menu do %>
        <%= menu_item t(".scan_keys"), server_scans_path, icon: :key, method: :post %>
      <% end %>
    <% end %>
  <% end %>

  <% if can?(:operate) && !@checklist.complete? %>
    <%= render "dashboard/checklist", checklist: @checklist %>
  <% end %>

  <%= stat_tiles do %>
    <%= stat_tile t(".online"), "#{@summary.online}/#{@summary.total}",
                  (@summary.unreachable.positive? ? t(".unreachable", count: @summary.unreachable) : t(".answer_their_ssh_port")),
                  icon: :check, id: "stat-online", href: servers_path(state: ("off" if @summary.unreachable.positive?)) %>
    <%= stat_tile t(".critical"), @summary.critical, t(".critical_caption"), tone: (:crit if @summary.critical.positive?), icon: :x_mark, id: "stat-critical",
                  href: servers_path(state: "crit") %>
    <%= stat_tile t(".watch"), @summary.to_watch, t(".reboot_disk_service"), tone: (:warn if @summary.to_watch.positive?), icon: :exclamation_triangle, id: "stat-to-watch",
                  href: servers_path(state: "warn") %>
    <%= stat_tile t(".serious_vulnerabilities"), @vulnerabilities&.value || 0, t(".fixable"), tone: (:crit if @vulnerabilities), icon: :shield_exclamation, id: "stat-vulnerabilities",
                  href: vulnerabilities_path(fixable: 1, origin: "host") %>
  <% end %>

  <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
    <%= panel t(".do"), meta: (t(".most_serious_first") if @attention.any?), id: "attention" do %>
      <% if @attention.any? %>
        <% @attention.by_tone.each do |tone, items| %>
          <%= tag.p t(".group_#{tone}", count: items.size), class: "attention-group border-t border-line bg-subtle/60 px-4 py-1.5 text-[11px] font-semibold tracking-wider text-ink-3 uppercase first:border-t-0", data: { tone: tone } %>
          <%= attention_list do %>
            <% items.each do |item| %>
              <%= attention_item (tone == "info" ? :neutral : tone.to_sym), item.text, icon: item.icon, servers: item.servers, action: [ item.action, item.path ] %>
            <% end %>
          <% end %>
        <% end %>
      <% else %>
        <%= empty_state t(".nothing_to_report"), t(".nothing_report_servers_reachable"), icon: :check_circle %>
      <% end %>
    <% end %>

    <div class="min-w-0 space-y-4">
      <%= panel t(".recent_activity"), link: [ t(".journal"), activities_path ], id: "recent-activity" do %>
        <% if @activities.any? %>
          <ul class="divide-y divide-line px-4"><%= render partial: "activities/activity", collection: @activities %></ul>
        <% else %>
          <p class="px-4 py-3 text-sm text-ink-3"><%= t(".activity_yet") %></p>
        <% end %>
      <% end %>

      <% if @groups.any? %>
        <%= panel t(".by_group"), id: "groups" do %>
          <ul class="divide-y divide-line">
            <% @groups.each do |group| %>
              <% members = @servers.select { |server| server.server_groups.include?(group) } %>
              <% critical = members.count { |server| %w[crit off].include?(server.health_state) } %>
              <% watch = members.count { |server| server.health_state == "warn" } %>
              <li class="group-summary">
                <%= link_to servers_path(group: group.id), class: "flex items-center gap-3 px-4 py-2 hover:bg-subtle" do %>
                  <span class="h-2 w-2 shrink-0 rounded-full <%= group.dot_classes %>"></span>
                  <span class="min-w-0 flex-1">
                    <span class="block text-sm"><%= group.name %></span>
                    <span class="block text-xs text-ink-3">
                      <% parts = [ (t(".group_critical", count: critical) if critical.positive?), (t(".group_watch", count: watch) if watch.positive?) ].compact %>
                      <%= parts.any? ? parts.join(" · ") : t(".group_fine") %>
                    </span>
                  </span>
                  <span class="text-xs tabular-nums text-ink-3"><%= members.size %></span>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% end %>
      <% end %>

      <% if @temporary_accesses.any? %>
        <%= panel t(".temporary_access"), meta: t(".ongoing_html", count: @temporary_accesses.size), id: "temporary-accesses" do %>
          <ul class="divide-y divide-line">
            <% @temporary_accesses.each do |access| %>
              <li class="temporary-access px-4 py-2.5 text-sm">
                <p class="truncate font-medium"><%= access.public_key&.name || t(".key_deleted") %></p>
                <p class="text-xs text-ink-3">
                  <%= link_to access.server.name, server_path(access.server, tab: "keys"), class: "hover:underline" %> ·
                  <span class="font-mono"><%= access.unix_user %></span> ·
                  <%= relative_time_tag access.expires_at, prefix: "expire ", expired: t(".expired_being_removed") %>
                </p>
              </li>
            <% end %>
          </ul>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
