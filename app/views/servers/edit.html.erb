<% content_for :title, t("title", page: t(".title", name: @server.name_was)) %>
<% temporary = @server.temporary_accesses.active.count %>
<% warning = t("servers.delete_button.warning", server_name: @server.name_was) + (temporary.positive? ? t("servers.delete_button.temporary_warning", count: temporary) : "") %>

<%= page_header t(".edit_html", name_was: @server.name_was), crumbs: [ [ t("nav.fleet"), servers_path ], [ @server.name_was, server_path(@server) ], t(".modify") ] do %>
  <%= actions_menu do %>
    <%= menu_item t(".delete_server"), server_path(@server), icon: :trash, method: :delete, danger: true, confirm: warning,
                  data: { confirm_label: t("servers.delete_button.delete_server") }, class: "delete-server" %>
  <% end %>
<% end %>

<div class="card max-w-4xl px-5 py-5">
  <%= render "form", server: @server %>
</div>
