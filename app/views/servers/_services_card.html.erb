<%# Services of the server from its last inventory (Inventory::Collectors::Services): the systemd units; the containers are in the Docker tab. %>
<% snapshot = server.inventory("services") %>
<% data = snapshot&.collected? ? snapshot.data : nil %>
<%# The failed units, with those only the health reading saw (Inventory::FailedUnits). %>
<% failed_units = Inventory::FailedUnits.new(server) %>
<section id="server-services" class="card">
  <div class="card-header">
    <h2 class="flex items-center gap-2 font-semibold"><%= icon :list_bullet, class: "h-4 w-4 text-ink-3" %> Services</h2>
    <div class="flex items-center gap-2 text-xs text-ink-3">
      <%= inventory_status_badge(snapshot) %>
      <% if snapshot&.collected_at %><%= t(".read_html", collected_at: (relative_time_tag snapshot.collected_at)) %><% end %>
    </div>
  </div>

  <% if data && snapshot.status != "unsupported" %>
    <% units = Array(data["units"]) %>
    <% failed = failed_units.units %>
    <% active = units.select { |unit| unit["active"] == "active" } %>
    <% others = units.reject { |unit| unit["active"].in?(%w[failed active]) } %>
    <% containers = Array(data["containers"]) %>
    <p class="services-summary border-b border-line px-4 py-2.5 text-xs text-ink-2">
      <strong class="text-ink"><%= active.size %></strong> <%= t(".active_services") %>
      <% if failed.any? %>· <strong class="text-crit-ink"><%= t(".failed_html", count: failed.size) %></strong><% end %>
      <%= t(".inactive_html", count: others.size) %>
      <% if data["docker"] == "ok" %>· <strong class="text-ink"><%= containers.count { |c| c["state"] == "running" } %></strong><%= t(".containers_running_html", count: containers.size) %><% end %>
    </p>

    <div>
      <div class="systemd-units">
        <h3 class="px-4 pt-3 text-xs font-semibold tracking-wide text-ink-3 uppercase">systemd</h3>
        <% if units.any? || failed.any? %>
          <ul class="divide-y divide-line">
            <%= render partial: "servers/systemd_unit", collection: failed + active, as: :unit %>
          </ul>
          <% if others.any? %>
            <details class="border-t border-line">
              <summary class="cursor-pointer px-4 py-2 text-xs text-ink-3 hover:text-ink"><%= t(".show_inactive_services_html", count: others.size) %></summary>
              <ul class="divide-y divide-line"><%= render partial: "servers/systemd_unit", collection: others, as: :unit %></ul>
            </details>
          <% end %>
        <% else %>
          <p class="px-4 py-3 text-sm text-ink-3"><%= t(".systemd_system") %></p>
        <% end %>
      </div>

    </div>
    <% if data["docker"].in?(%w[ok unreadable]) %>
      <p class="services-docker-link border-t border-line px-4 py-2.5 text-xs text-ink-3">
        <%= t(".containers_in_docker_tab", count: containers.size) %>
        <%= link_to t(".see_docker_tab"), server_path(server, tab: "docker"), class: "font-medium text-accent hover:underline" %>
      </p>
    <% end %>
  <% elsif failed_units.health_only.any? %>
    <ul class="divide-y divide-line border-b border-line"><%= render partial: "servers/systemd_unit", collection: failed_units.health_only, as: :unit %></ul>
    <p class="services-empty px-4 py-3 text-sm text-ink-3"><%= snapshot&.failed? || snapshot&.status == "unsupported" ? snapshot.message : t(".services_inventory_yet") %></p>
  <% elsif snapshot&.status == "unsupported" %>
    <p class="services-empty px-4 py-4 text-sm text-ink-3"><%= snapshot.message %></p>
  <% elsif snapshot&.failed? %>
    <p class="inventory-error px-4 py-4 text-sm text-crit-ink"><%= snapshot.message %></p>
  <% else %>
    <p class="services-empty px-4 py-4 text-sm text-ink-3"><%= t(".services_inventory_yet") %></p>
  <% end %>
</section>
