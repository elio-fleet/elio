<div class="flex min-h-7 flex-nowrap items-center gap-x-2">
  <span class="shrink-0 text-[11px] font-semibold uppercase tracking-wider text-ink-3"><%= label %></span>
  <%= yield %>
  <% if local_assigns[:refresh_path] %>
    <%= link_to refresh_path, title: local_assigns[:refresh_title], aria: { label: local_assigns[:refresh_title] }, data: { turbo_prefetch: false },
          class: "health-refresh rounded-md p-1 text-ink-3 hover:bg-subtle hover:text-ink-2" do %>
      <%= icon :arrow_path, class: "h-4 w-4 group-aria-busy:animate-spin" %>
    <% end %>
  <% end %>
</div>
