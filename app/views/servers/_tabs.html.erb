<%# Tabs of the server page ([tab, label, count, tone]; a tone "warn" / "crit" colours the count):
    those that fit stay visible, the others go into
    a "More" menu (overflow-tabs controller, the current tab always visible);
    a drop-down list on small screens. Without JavaScript the bar scrolls. %>
<% tab_path = ->(tab) { server_path(server, tab: (tab unless tab == "overview")) } %>
<% current_label = tabs.find { |tab, _| tab == current }&.second %>
<% count_class = ->(tone) { { "crit" => "bg-crit-soft text-crit-ink", "warn" => "bg-warn-soft text-warn-ink" }.fetch(tone.to_s, "bg-subtle text-ink-2") } %>
<nav class="server-tabs mt-5 border-b border-line text-sm" aria-label="<%= t(".server_sections") %>"
     data-controller="overflow-tabs">
  <div class="sm:hidden pb-3">
    <label for="server-tab-select" class="sr-only"><%= t(".section") %></label>
    <select id="server-tab-select" class="server-tab-select input text-sm" data-action="change->overflow-tabs#visit">
      <% tabs.each do |tab, label, count| %>
        <option value="<%= tab_path.(tab) %>" <%= "selected" if tab == current %>><%= label %><%= " (#{count})" if count %></option>
      <% end %>
    </select>
  </div>
  <div class="server-tabs-bar scrollbar-none hidden gap-5 overflow-x-auto sm:flex" data-overflow-tabs-target="bar">
    <% tabs.each do |tab, label, count, tone| %>
      <% active = tab == current %>
      <%= link_to tab_path.(tab), aria: { current: (active ? "page" : nil) }, data: { tab: tab, overflow_tabs_target: "tab" },
            class: "flex shrink-0 items-center gap-1.5 whitespace-nowrap border-b-2 px-1 pb-2.5 #{active ? "border-accent font-medium text-ink" : "border-transparent text-ink-3 hover:text-ink"}" do %>
        <%= label %><% if count %><span class="rounded-full px-1.5 text-[11px] <%= count_class.(tone) %>" data-tone="<%= tone %>"><%= count %></span><% end %>
      <% end %>
    <% end %>
    <details class="server-tabs-more dropdown relative shrink-0" hidden data-overflow-tabs-target="more"
             data-controller="dropdown" data-action="keydown->dropdown#keydown click->dropdown#chosen">
      <summary class="flex cursor-pointer list-none items-center gap-1 border-b-2 border-transparent px-1 pb-2.5 text-ink-3 hover:text-ink [&::-webkit-details-marker]:hidden" aria-haspopup="menu">
        <%= t(".more") %> <%= icon :chevron_down, class: "h-4 w-4" %>
      </summary>
      <div role="menu" aria-label="<%= t(".more") %>" class="dropdown-menu absolute right-0 z-30 mt-1 w-56 rounded-lg border border-line bg-surface py-1 shadow-lg">
        <% tabs.each do |tab, label, count, tone| %>
          <%= link_to tab_path.(tab), role: "menuitem", hidden: true, data: { tab: tab, overflow_tabs_target: "item" },
                class: "dropdown-item flex items-center justify-between gap-2 px-3 py-2 text-sm text-ink-2 hover:bg-subtle hover:text-ink focus:bg-subtle focus:outline-none" do %>
            <%= label %><% if count %><span class="rounded-full px-1.5 text-[11px] <%= count_class.(tone) %>"><%= count %></span><% end %>
          <% end %>
        <% end %>
      </div>
    </details>
  </div>
</nav>
