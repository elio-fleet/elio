<%# The fix plan of the server (Vulnerabilities::FixCommands on its fixable vulnerabilities), folded: the system packages in one command,
    then every step most serious first (system packages by severity, Compose projects, images), and what to restart. Copied, never run by Elio.
    Locals: server, fix. %>
<% steps = fix.steps %>
<% if steps.any? %>
  <% system = fix.system_plan %>
  <% reboot = steps.any?(&:reboot) %>
  <details class="fix-plan group/plan border-b border-line">
    <summary class="flex cursor-pointer list-none items-center gap-2 px-4 py-2.5 text-xs text-ink-2 hover:bg-subtle [&::-webkit-details-marker]:hidden">
      <%= icon :arrow_up_circle, class: "h-4 w-4 text-ink-3" %>
      <span><%= t("servers.fix_plan.summary_html", steps: tag.strong(t("servers.fix_plan.steps", count: steps.size), class: "text-ink"),
                  cves: tag.strong("#{number_with_delimiter(steps.flat_map(&:cves).uniq.size)} CVE", class: "text-ink")) %></span>
      <span class="text-ink-3"><%= t("servers.fix_plan.never_run") %></span>
      <%= icon :chevron_right, class: "ml-auto h-4 w-4 text-ink-3 transition-transform group-open/plan:rotate-90" %>
    </summary>

    <div class="space-y-4 border-t border-dashed border-line bg-subtle/40 px-4 py-4">
      <% if system&.fixable? %>
        <div class="fix-plan-system" data-controller="clipboard">
          <p class="text-xs font-medium text-ink-2"><%= t("servers.fix_plan.all_system", count: system.packages.size) %></p>
          <% if system.state == :pending %><p class="mt-0.5 text-xs text-ink-3"><%= t("vulnerabilities.fix_plans.hint_pending") %></p><% end %>
          <div class="mt-1.5 flex items-start gap-2">
            <pre data-clipboard-target="source" class="fix-commands min-w-0 flex-1 overflow-x-auto rounded-md bg-neutral-950 px-3 py-2 font-mono text-xs text-neutral-100"><%= system.commands.join("\n") %></pre>
            <%= render "settings/copy_button" %>
          </div>
        </div>
      <% end %>

      <%# A single step that the command of the system already holds is not repeated. %>
      <% if steps.size > 1 || !system&.fixable? %>
      <div>
        <p class="text-xs font-medium text-ink-2"><%= t("servers.fix_plan.ordered") %></p>
        <ol class="mt-1.5 divide-y divide-line rounded-lg border border-line bg-surface">
          <% steps.each_with_index do |step, index| %>
            <li class="fix-step px-3 py-2.5" data-kind="<%= step.kind %>" data-severity="<%= step.severity %>" data-controller="clipboard">
              <p class="flex flex-wrap items-center gap-2 text-xs">
                <span class="tabular-nums text-ink-3"><%= index + 1 %>.</span>
                <%= severity_badge(step.severity) %>
                <span class="font-medium text-ink">
                  <% if step.kind == :packages %><%= t("servers.fix_plan.packages", count: step.packages.size) %>
                  <% elsif step.kind == :compose %><%= t("servers.fix_plan.compose_html", name: tag.span(step.name, class: "font-mono")) %>
                  <% else %><%= t("servers.fix_plan.image_html", image: tag.span(image_label(step.name), class: "font-mono", title: step.name)) %>
                  <% end %>
                </span>
                <span class="text-ink-2"><%= t("words.fixes_html", count: tag.strong(number_with_delimiter(step.cves.size))) %></span>
              </p>
              <p class="mt-1 truncate text-[11px] text-ink-3" title="<%= step.packages.join(", ") %>">
                <% if step.kind == :packages %><span class="font-mono"><%= step.packages.join(" ") %></span>
                <% else %><%= t("servers.fix_plan.images_containers", images: step.images.map { |image| image_label(image) }.join(", "), containers: step.containers.join(", ").presence || "—") %>
                <% end %>
              </p>
              <% if step.reboot %><p class="mt-1 text-[11px] text-warn-ink"><%= t("vulnerabilities.fix_plans.reboot") %></p><% end %>
              <% if step.kind == :image && step.containers.any? %><p class="mt-1 text-[11px] text-ink-3"><%= t("servers.fix_plan.recreate") %></p><% end %>
              <div class="mt-1.5 flex items-start gap-2">
                <pre data-clipboard-target="source" class="fix-commands min-w-0 flex-1 overflow-x-auto rounded-md bg-neutral-950 px-3 py-2 font-mono text-xs text-neutral-100"><%= step.commands.join("\n") %></pre>
                <%= render "settings/copy_button" %>
              </div>
            </li>
          <% end %>
        </ol>
      </div>
      <% end %>

      <div class="fix-plan-after space-y-1 text-xs text-ink-3">
        <p class="font-medium text-ink-2"><%= t("servers.fix_plan.after") %></p>
        <% if steps.any? { |step| step.kind == :packages } %>
          <p class="fix-plan-restart"><%= t("servers.fix_plan.restart_html", command: tag.code("#{"sudo " unless server.username == "root"}needrestart -r l", class: "font-mono text-ink-2")) %></p>
        <% end %>
        <% if reboot || server.inventory("health")&.data&.dig("reboot_required") %>
          <p class="fix-plan-reboot text-warn-ink"><%= server.inventory("health")&.data&.dig("reboot_required") ? t("servers.fix_plan.reboot_waiting") : t("servers.fix_plan.reboot") %></p>
        <% end %>
        <p><%= t("servers.fix_plan.check") %></p>
      </div>
    </div>
  </details>
<% end %>
