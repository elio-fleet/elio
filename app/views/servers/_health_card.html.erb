<%# Health of the server: figures of the last inventory (Inventory::Collectors::Health), what needs attention, 24-hour history, disks. %>
<% snapshot = server.inventory("health") %>
<% health = snapshot&.collected? ? snapshot.data : nil %>
<% settings = app_settings %>
<section id="server-health-details" class="card">
  <div class="card-header">
    <h2 class="flex items-center gap-2 text-sm font-semibold"><%= icon :pulse, class: "h-4 w-4 text-ink-3" %> <%= t(".health") %></h2>
    <div class="flex items-center gap-2 text-xs text-ink-3">
      <%= inventory_status_badge(snapshot) %>
      <% if snapshot&.collected_at %><%= t(".read_html", collected_at: (relative_time_tag snapshot.collected_at)) %><% end %>
    </div>
  </div>

  <% if health %>
    <% memory = health["memory"] || {} %>
    <% fullest = Array(health["disks"]).max_by { |disk| disk["used_percent"].to_f } %>
    <table class="health-now table-dense">
      <tbody>
        <tr class="health-load">
          <td class="w-48 pl-4 text-xs text-ink-3"><%= t(".load") %></td>
          <td><span class="font-semibold tabular-nums"><%= number_with_precision(health.dig("load", 0), precision: 2, strip_insignificant_zeros: true) %></span>
            <span class="text-xs text-ink-3">/ <%= t("count.processors", count: health["cpus"].to_i) %></span></td>
          <td class="pr-4 text-right"><%= sparkline @health_history.map { |_, load, _, _| load }, max: 100, width: 200, height: 22, title: t(".load_over_24_h") %></td>
        </tr>
        <tr class="health-memory">
          <td class="pl-4 text-xs text-ink-3"><%= t(".memory") %></td>
          <td><div class="flex flex-wrap items-center gap-x-3"><%= meter memory["used_percent"], warn: settings.health_memory_warn, crit: settings.health_memory_crit, width: "w-24" %>
            <span class="text-xs text-ink-3"><%= human_bytes(memory["total"].to_i - memory["available"].to_i) %> / <%= human_bytes(memory["total"]) %></span></div></td>
          <td class="pr-4 text-right"><%= sparkline @health_history.map { |_, _, used, _| used }, max: 100, width: 200, height: 22, title: t(".memory") %></td>
        </tr>
        <tr class="health-disk">
          <td class="pl-4 text-xs text-ink-3"><%= t(".fullest_disk") %><% if fullest %> · <span class="font-mono"><%= fullest["mount"] %></span><% end %></td>
          <td><% if fullest %><div class="flex flex-wrap items-center gap-x-3"><%= meter fullest["used_percent"], warn: settings.health_disk_warn, crit: settings.health_disk_crit, width: "w-24" %>
            <span class="text-xs text-ink-3"><%= human_bytes(fullest["used"]) %> / <%= human_bytes(fullest["size"]) %></span></div><% else %><span class="text-ink-3">—</span><% end %></td>
          <td class="pr-4 text-right"><%= sparkline @health_history.map { |_, _, _, disk| disk }, max: 100, width: 200, height: 22, title: t(".fullest_disk"),
                                                    color: (fullest && fullest["used_percent"] >= settings.health_disk_crit ? "var(--color-crit)" : "var(--color-spark)") %></td>
        </tr>
      </tbody>
    </table>

    <%= fact_list [ [ t(".updates"), (updates = health["updates"]) ? safe_join([ updates["total"], (" " if updates["security"].to_i.positive?), (t(".including_html", security: tag.span(t(".security_html", security: updates["security"]), class: "font-medium text-crit-ink")) if updates["security"].to_i.positive?) ].compact) : "—" ],
                    [ t(".reboot_required"), health["reboot_required"] ? t("words.yes") : t("words.no") ],
                    [ t(".failed_services"), tag.span(Array(health["failed_units"]).join(", ").presence || t("words.none"), class: "font-mono") ],
                    [ t("words.clock"), { true => t(".synchronized"), false => t(".not_synchronized") }.fetch(health["ntp_synchronized"], "—") ],
                    [ t("words.swap"), ((swap = health["swap"]) ? t(".swap_html", percent: number_to_percentage(swap["used_percent"], precision: 0), size: human_bytes(swap["total"])) : nil) ] ],
                  class: "health-facts border-t border-line" %>

    <% if Array(health["disks"]).any? %>
      <table id="disks" class="health-disks table-dense border-t border-line">
        <thead><tr><th class="pl-4"><%= t(".mount_point") %></th><th>Type</th><th><%= t("words.size") %></th><th><%= t(".used") %></th><th class="pr-4">Inodes</th></tr></thead>
        <tbody>
          <% health["disks"].each do |disk| %>
            <tr>
              <td class="pl-4 font-mono text-xs"><%= disk["mount"] %></td>
              <td class="text-xs text-ink-2"><%= disk["type"] %></td>
              <td class="text-xs tabular-nums"><%= human_bytes(disk["size"]) %></td>
              <td><%= meter disk["used_percent"], warn: settings.health_disk_warn, crit: settings.health_disk_crit, width: "w-24" %></td>
              <td class="pr-4 text-xs tabular-nums text-ink-2"><%= disk["inodes_used_percent"] ? number_to_percentage(disk["inodes_used_percent"], precision: 0) : "—" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>

    <details id="disks-charts" class="health-history-details border-t border-line">
      <summary class="cursor-pointer list-none px-4 py-2 text-xs font-medium text-accent hover:underline [&::-webkit-details-marker]:hidden"><%= t(".charts_24_h") %></summary>
      <div class="health-history grid gap-4 px-4 pb-4 sm:grid-cols-3">
        <%= history_chart @health_history.map { |time, load, _, _| [ time, load ] }, label: t(".load_processors") %>
        <%= history_chart @health_history.map { |time, _, memory, _| [ time, memory ] }, label: t(".memory"), threshold: settings.health_memory_warn %>
        <%= history_chart @health_history.map { |time, _, _, disk| [ time, disk ] }, label: t(".fullest_disk"), threshold: settings.health_disk_warn,
                          color: (fullest && fullest["used_percent"] >= settings.health_disk_crit ? "var(--color-crit)" : "var(--color-accent)") %>
      </div>
    </details>
  <% elsif snapshot&.failed? %>
    <p class="inventory-error px-4 py-4 text-sm text-crit-ink"><%= snapshot.message %></p>
  <% else %>
    <p class="health-empty px-4 py-4 text-sm text-ink-3"><%= t(".measure_yet_run_inventory") %></p>
  <% end %>
</section>
