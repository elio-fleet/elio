<%# Scheduled tasks of the server from its last inventory (Inventory::Collectors::ScheduledTasks): systemd timers, crontabs, cron.* scripts. %>
<% snapshot = server.inventory("scheduled_tasks") %>
<% data = snapshot&.collected? && snapshot.status != "unsupported" ? snapshot.data : nil %>
<section id="server-scheduled-tasks" class="card">
  <div class="card-header">
    <h2 class="flex items-center gap-2 font-semibold"><%= icon :calendar, class: "h-4 w-4 text-ink-3" %> <%= t(".scheduled_tasks") %></h2>
    <div class="flex items-center gap-3 text-xs text-ink-3">
      <%= inventory_status_badge(snapshot) %>
      <% if snapshot&.collected_at %><span><%= t(".read_html", collected_at: (relative_time_tag snapshot.collected_at)) %></span><% end %>
      <%= link_to t(".search_whole_fleet"), scheduled_tasks_path, class: "font-medium text-accent hover:underline" %>
    </div>
  </div>

  <% if data %>
    <% timers = Array(data["timers"]).sort_by { |timer| [ timer["failed"] ? 0 : timer["late"] ? 1 : timer["active"] == "active" ? 2 : 3, timer["name"] ] } %>
    <% cron = Array(data["cron"]) %>
    <% periodic = Array(data["periodic"]) %>
    <p class="scheduled-tasks-summary border-b border-line px-4 py-2.5 text-xs text-ink-2">
      <strong class="text-ink"><%= timers.size %></strong> <%= t(".systemd_timers") %>
      <% if (failed = timers.count { |timer| timer["failed"] }).positive? %>· <strong class="text-crit-ink"><%= t(".failed_html", failed: failed) %></strong><% end %>
      <% if (late = timers.count { |timer| timer["late"] && !timer["failed"] }).positive? %>· <strong class="text-warn-ink"><%= t(".late_html", late: late) %></strong><% end %>
      · <strong class="text-ink"><%= cron.size %></strong> <%= t(".cron_lines_periodic_scripts_html", count: periodic.size) %>
    </p>

    <% if data["user_crontabs"] == "unreadable" %>
      <p class="crontabs-unreadable border-b border-line px-4 py-2.5 text-xs text-warn-ink"><%= snapshot.message %></p>
    <% end %>

    <h3 class="px-4 pt-3 text-xs font-semibold tracking-wide text-ink-3 uppercase"><%= t(".systemd_timers_2") %></h3>
    <% if timers.any? %>
      <div class="overflow-x-auto">
        <table class="table-dense">
          <thead><tr><th class="pl-4"><%= t(".state") %></th><th><%= t("words.timer") %></th><th><%= t("words.when") %></th><th><%= t(".last_run") %></th><th class="pr-4"><%= t("words.next") %></th></tr></thead>
          <tbody>
            <% timers.each do |timer| %>
              <tr class="systemd-timer" data-name="<%= timer["name"] %>">
                <td class="pl-4"><%= timer_state_badge(timer) %></td>
                <td><span class="font-mono text-xs"><%= timer["name"].delete_suffix(".timer") %></span>
                  <% if timer["description"] %><span class="block text-[11px] text-ink-3"><%= timer["description"] %></span><% end %></td>
                <td class="text-xs" title="<%= Array(timer["schedules"]).join("\n") %>"><%= timer_schedule_text(timer) %></td>
                <td class="text-xs"><%= timer_time(timer["last_at"]) %></td>
                <td class="pr-4 text-xs"><%= timer_time(timer["next_at"]) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="px-4 py-3 text-sm text-ink-3"><%= t(".systemd_timer") %></p>
    <% end %>

    <h3 class="border-t border-line px-4 pt-3 text-xs font-semibold tracking-wide text-ink-3 uppercase"><%= t("words.cron") %></h3>
    <% if cron.any? %>
      <div class="overflow-x-auto">
        <table class="table-dense">
          <thead><tr><th class="pl-4"><%= t("words.when") %></th><th><%= t("words.user") %></th><th><%= t("words.command") %></th><th class="pr-4"><%= t("words.file") %></th></tr></thead>
          <tbody>
            <% cron.each do |task| %>
              <tr class="cron-task">
                <td class="pl-4 text-xs whitespace-nowrap" title="<%= task["schedule"] %>"><%= cron_schedule_text(task) %></td>
                <td class="font-mono text-xs"><%= task["user"] %></td>
                <td class="max-w-md truncate font-mono text-xs" title="<%= task["command"] %>"><%= task["command"] %></td>
                <td class="pr-4 text-xs text-ink-3"><%= task["source"] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="px-4 py-3 text-sm text-ink-3"><%= t(".cron_line") %></p>
    <% end %>

    <% if periodic.any? %>
      <h3 class="border-t border-line px-4 pt-3 text-xs font-semibold tracking-wide text-ink-3 uppercase"><%= t(".periodic_scripts") %></h3>
      <ul class="periodic-scripts space-y-1 px-4 py-3 text-xs">
        <% periodic.group_by { |task| task["period"] }.each do |period, tasks| %>
          <li><span class="text-ink-2"><%= period_label(period).upcase_first %></span>
            <span class="text-ink-3"><%= t(".etc_cron_html", period: period) %></span> : <span class="font-mono"><%= tasks.map { |task| task["name"] }.join(", ") %></span></li>
        <% end %>
      </ul>
    <% end %>
  <% elsif snapshot&.status == "unsupported" %>
    <p class="scheduled-tasks-empty px-4 py-4 text-sm text-ink-3"><%= snapshot.message %></p>
  <% elsif snapshot&.failed? %>
    <p class="inventory-error px-4 py-4 text-sm text-crit-ink"><%= snapshot.message %></p>
  <% else %>
    <p class="scheduled-tasks-empty px-4 py-4 text-sm text-ink-3"><%= t(".scheduled_tasks_inventory_yet") %></p>
  <% end %>
</section>
