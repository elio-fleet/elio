<%# Docker of the server (Inventory::Collectors::Docker), in sections (`section`: containers, images, vulnerabilities):
    the containers, the images (updates, vulnerabilities, disk usage), the vulnerabilities of the images by package
    (`groups`, `pager`: PackageVulnerabilities, ServersController#show_docker). Locals: server, section, groups, pager,
    image_cves, image_fixable. %>
<% snapshot = server.inventory("docker") %>
<% data = snapshot&.collected? ? snapshot.data : {} %>
<% containers = Array(data["containers"]) %>
<% images = Array(data["images"]) %>
<% updates = ImageUpdate.for_images(images) %>
<% section = local_assigns[:section] || "containers" %>
<% troubled = containers.count { |container| container["looping"] || container["health"] == "unhealthy" } %>
<% cves = server.server_vulnerabilities.images.group(:image).pluck(:image, Arel.sql("COUNT(DISTINCT cve)"), Arel.sql("COUNT(DISTINCT cve) FILTER (WHERE fixed_version IS NOT NULL)")).to_h { |image, total, fixable| [ image, [ total, fixable ] ] } %>
<section id="server-docker" class="card mt-6">
  <div class="card-header">
    <h2 class="flex items-center gap-2 font-semibold"><%= icon :docker, class: "h-4 w-4 text-ink-3" %> Docker <% if data["version"] %><span class="text-xs font-normal text-ink-3"><%= data["version"] %></span><% end %></h2>
    <div class="flex items-center gap-3 text-xs text-ink-3">
      <%= inventory_status_badge(snapshot) %>
      <% if snapshot&.collected_at %><span><%= t(".read_html", collected_at: (relative_time_tag snapshot.collected_at)) %></span><% end %>
      <%= link_to t(".images_fleet"), docker_path, class: "font-medium text-accent hover:underline" %>
    </div>
  </div>

  <% if data["docker"] == "ok" %>
    <p class="docker-summary border-b border-line px-4 py-2.5 text-xs text-ink-2">
      <strong class="text-ink"><%= containers.count { |container| container["state"] == "running" } %></strong><%= t(".containers_running_html", count: containers.size) %>
      <% if (problems = troubled).positive? %>· <strong class="text-crit-ink"><%= t(".trouble_html", problems: problems) %></strong><% end %>
      · <strong class="text-ink"><%= images.size %></strong> <%= t(".images_unused_html", used: (images.count { |image| !image["used"] })) %>
      <% if (disk = data.dig("disk", "images")) %><%= t(".images_reclaimable_html", human_bytes: (human_bytes(disk["size"])), human_bytes2: (human_bytes(disk["reclaimable"]))) %><% end %>
      <%= t(".analysis") %> <%= data["scanner"] ? scan_label(data["scanner"]) : t(".elio_neither_trivy_nor") %>
    </p>

    <% sections = [ [ "containers", t("words.containers"), containers.size, ("crit" if troubled.positive?) ],
                    [ "images", "Images", images.size, nil ],
                    [ "vulnerabilities", t(".vulnerabilities"), local_assigns[:image_cves].to_i, ("warn" if local_assigns[:image_fixable].to_i.positive?) ] ] %>
    <nav class="docker-sections border-b border-line px-4 py-2" aria-label="<%= t(".sections") %>">
      <div class="inline-flex flex-wrap gap-0.5 rounded-lg border border-line bg-surface p-0.5 text-xs">
        <% sections.each do |key, label, count, tone| %>
          <%= link_to server_path(server, tab: "docker", section: (key unless key == "containers")), data: { section: key }, aria: { current: (section == key ? "page" : nil) },
                class: "inline-flex items-center gap-1.5 rounded-md px-2.5 py-1 #{section == key ? "bg-subtle font-medium text-ink" : "text-ink-3 hover:text-ink"}" do %>
            <%= label %><span class="rounded-full px-1.5 text-[11px] <%= { "crit" => "bg-crit-soft text-crit-ink", "warn" => "bg-warn-soft text-warn-ink" }.fetch(tone.to_s, "bg-subtle text-ink-2") %>"><%= count %></span>
          <% end %>
        <% end %>
      </div>
    </nav>

    <% if section == "containers" %>
    <% if containers.any? %>
      <div class="overflow-x-auto">
        <table class="table-dense">
          <thead><tr><th class="pl-4"><%= t(".state") %></th><th><%= t("words.container") %></th><th>Image</th><th class="text-right"><%= t(".restarts") %></th><th class="text-right">CPU</th><th class="text-right"><%= t(".memory") %></th><th class="pr-4"><%= t(".since") %></th></tr></thead>
          <tbody>
            <% containers.sort_by { |container| [ container["looping"] || container["health"] == "unhealthy" ? 0 : container["state"] == "running" ? 1 : 2, container["name"] ] }.each do |container| %>
              <tr class="docker-container-row" data-name="<%= container["name"] %>" data-state="<%= container["state"] %>">
                <td class="pl-4"><%= container_state_badge(container) %></td>
                <td><span class="font-mono text-xs"><%= container["name"] %></span>
                  <% if container["project"] %><span class="block text-[11px] text-ink-3"><%= container["project"] %> · <%= container["service"] %></span><% end %></td>
                <td class="font-mono text-xs text-ink-2"><%= container["image"] %></td>
                <td class="text-right text-xs tabular-nums <%= "text-crit-ink" if container["looping"] %>"><%= container["restarts"] %></td>
                <td class="text-right text-xs tabular-nums"><%= container["cpu_percent"] ? number_to_percentage(container["cpu_percent"], precision: 1) : "—" %></td>
                <td class="text-right text-xs tabular-nums"><%= container["memory_bytes"]&.positive? ? human_bytes(container["memory_bytes"]) : "—" %></td>
                <td class="pr-4 text-xs whitespace-nowrap">
                  <% if container["state"] == "running" && container["started_at"] %><%= relative_time_tag Time.zone.parse(container["started_at"]) %>
                  <% elsif container["finished_at"] %><span class="<%= "text-warn-ink" if container["stopped_long"] %>"><%= t(".stopped_html", parse: (relative_time_tag Time.zone.parse(container["finished_at"]))) %></span>
                  <% else %>—<% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="px-4 py-3 text-sm text-ink-3"><%= t(".container") %></p>
    <% end %>

    <% elsif section == "images" %>
    <% if images.any? %>
      <div class="overflow-x-auto">
        <table class="table-dense">
          <thead><tr><th class="pl-4">Image</th><th><%= t(".created") %></th><th class="text-right"><%= t("words.size") %></th><th><%= t(".used") %></th><th><%= t("words.registry") %></th><th class="pr-4"><%= t(".vulnerabilities") %></th></tr></thead>
          <tbody>
            <% images.sort_by { |image| [ image["used"] ? 0 : 1, image["reference"].to_s ] }.each do |image| %>
              <% scan = data.dig("scans", image["id"]) || {} %>
              <% total, fixable = cves[image["reference"]] %>
              <tr class="docker-image" data-reference="<%= image["reference"] %>">
                <td class="pl-4"><span class="font-mono text-xs"><%= image["tags"].presence&.join(", ") || tag.span(t(".tag"), class: "text-ink-3") %></span>
                  <% if Array(image["tags"]).any? { |tag| tag.end_with?(":latest") } %><%= status_badge :neutral, "latest", class: "ml-1", title: t(".moving_tag_real_version") %><% end %>
                  <span class="block font-mono text-[11px] text-ink-3"><%= image["id"].delete_prefix("sha256:").first(12) %><% if image.dig("os", "name") %> · <%= image.dig("os", "name") %><% end %></span></td>
                <td class="text-xs whitespace-nowrap"><%= image["created_at"] ? relative_time_tag(Time.zone.parse(image["created_at"])) : "—" %></td>
                <td class="text-right text-xs tabular-nums"><%= human_bytes(image["size"]) %></td>
                <td class="text-xs"><%= image["used"] ? t("words.yes") : tag.span(t("words.no"), class: "text-warn-ink") %></td>
                <td class="text-xs"><%= image_update_badge(ImageUpdate.state_for(image, updates)) %></td>
                <td class="pr-4 text-xs">
                  <% if total.to_i.positive? %>
                    <%= link_to server_path(server, tab: "docker", section: "vulnerabilities"), class: "hover:underline" do %><strong class="<%= fixable.to_i.positive? ? "text-crit-ink" : "text-ink" %>"><%= total %></strong> <%= t(".including_fixable_html", fixable: fixable) %><% end %>
                  <% elsif scan["error"] %><span class="text-warn-ink" title="<%= scan["error"] %>"><%= scan["error"].truncate(60) %></span>
                  <% elsif scan["count"] %><span class="text-good-ink"><%= t(".none") %></span>
                  <% else %><span class="text-ink-3"><%= scan_label(scan["method"]) %></span><% end %>
                  <% if scan["at"] && scan["method"] != "none" %><span class="block text-[11px] text-ink-3"><%= scan_label(scan["method"]) %> · <%= relative_time_tag Time.zone.parse(scan["at"]) %></span><% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="px-4 py-3 text-sm text-ink-3"><%= t(".image") %></p>
    <% end %>
    <% else %>
      <% if groups.present? %>
        <%= render "servers/vulnerability_packages", server: server, groups: groups, pager: pager %>
      <% else %>
        <p class="image-vulnerabilities-empty px-4 py-3 text-sm text-ink-3"><%= t(".no_image_vulnerability") %></p>
      <% end %>
      <p class="border-t border-line px-4 py-2.5 text-xs text-ink-3"><%= t(".fixed_by_image") %></p>
    <% end %>
  <% elsif data["docker"] == "unreadable" %>
    <p class="docker-unreadable px-4 py-4 text-sm text-warn-ink"><%= snapshot.message %></p>
  <% elsif snapshot&.status == "unsupported" %>
    <p class="docker-empty px-4 py-4 text-sm text-ink-3"><%= snapshot.message %></p>
  <% elsif snapshot&.failed? %>
    <p class="inventory-error px-4 py-4 text-sm text-crit-ink"><%= snapshot.message %></p>
  <% else %>
    <p class="docker-empty px-4 py-4 text-sm text-ink-3"><%= t(".docker_inventory_yet") %></p>
  <% end %>
</section>
