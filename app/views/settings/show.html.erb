<% content_for :title, t("title", page: t("settings.nav.title")) %>

<%= render "settings/nav" %>

<section id="ssh-key" class="mt-8 rounded-xl border border-line bg-surface p-6 shadow-sm">
  <h2 class="text-lg font-semibold"><%= t(".ssh_key_application") %></h2>
  <p class="mt-1 text-sm text-ink-3">
    <%= t(".key_intro_html", file: tag.code("~/.ssh/authorized_keys", class: "rounded bg-subtle px-1 font-mono text-xs")) %>
  </p>

  <% if @ssh_key %>
    <dl class="mt-6 grid grid-cols-1 gap-4 text-sm sm:grid-cols-2">
      <div>
        <dt class="font-medium text-ink-2"><%= t("words.fingerprint") %></dt>
        <dd id="ssh-key-fingerprint" class="mt-1 break-all font-mono text-ink-2"><%= @ssh_key.fingerprint %></dd>
      </div>
      <div>
        <dt class="font-medium text-ink-2"><%= t(".generated") %></dt>
        <dd class="mt-1 text-ink-2"><%= relative_time_tag @ssh_key.created_at %></dd>
      </div>
    </dl>

    <div class="mt-6" data-controller="clipboard">
      <div class="flex items-end justify-between gap-4">
        <label for="ssh-public-key" class="text-sm font-medium text-ink-2"><%= t(".public_key") %></label>
        <%= render "copy_button" %>
      </div>
      <textarea id="ssh-public-key" readonly rows="3" data-clipboard-target="source"
                class="mt-2 block w-full resize-none rounded-md border border-line bg-subtle px-3 py-2 font-mono text-xs text-ink-2"><%= @ssh_key.public_key %></textarea>
    </div>

    <div class="mt-6" data-controller="clipboard">
      <div class="flex items-end justify-between gap-4">
        <label for="ssh-install-command" class="text-sm font-medium text-ink-2"><%= t(".command_run_each_server") %></label>
        <%= render "copy_button" %>
      </div>
      <textarea id="ssh-install-command" readonly rows="3" data-clipboard-target="source"
                class="mt-2 block w-full resize-none rounded-md border border-line bg-neutral-950 px-3 py-2 font-mono text-xs text-neutral-100"><%= ssh_key_install_command(@ssh_key) %></textarea>
    </div>

    <div id="key-rotation" class="mt-6 border-t border-line pt-6">
      <% if @rotation %>
        <div class="flex flex-wrap items-center justify-between gap-4 rounded-md border border-accent/40 bg-accent-soft/50 px-4 py-3">
          <p class="text-sm text-accent"><%= t(".key_rotation_progress_elio") %></p>
          <%= link_to t(".follow_rotation"), settings_key_rotation_path(@rotation), class: "text-sm font-medium text-accent hover:text-accent" %>
        </div>
      <% else %>
        <div class="flex flex-wrap items-center justify-between gap-4">
          <div>
            <p class="text-sm font-medium text-ink-2"><%= t(".rotate_key") %></p>
            <p class="text-sm text-ink-3"><%= t(".new_key_installed_each") %></p>
          </div>
          <%= button_to t(".rotate_key"), settings_key_rotations_path,
                data: { turbo_confirm: t(".rotation_confirm", count: Server.count), confirm_label: t(".start_rotation") },
                class: "btn btn-primary shrink-0" %>
        </div>
      <% end %>
      <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
        <p class="text-sm text-ink-3"><%= t(".only_if_key_compromised") %></p>
        <%= button_to t(".regenerate_key"), ssh_key_path,
              data: { turbo_confirm: t(".old_key_will_deleted"),
                      confirm_label: t(".regenerate_key"), confirm_variant: "danger" },
              class: "shrink-0 cursor-pointer rounded-md border border-crit/40 bg-surface px-4 py-2 text-sm font-medium text-crit-ink shadow-sm hover:bg-crit-soft" %>
      </div>
    </div>
  <% else %>
    <div class="mt-6 rounded-lg border border-dashed border-line px-6 py-10 text-center">
      <p class="text-sm text-ink-3"><%= t(".ssh_key_has_been") %></p>
      <%= button_to t(".generate_ssh_key"), ssh_key_path,
            class: "btn btn-primary mt-4" %>
    </div>
  <% end %>
</section>

<%= render "settings/language" %>

<% setting = app_settings %>
<section id="health-thresholds" class="card mt-6">
  <div class="card-header">
    <h2 class="font-semibold"><%= t(".health_thresholds") %></h2>
    <span class="text-xs text-ink-3"><%= t(".beyond_them_server_watch") %></span>
  </div>
  <%= form_with model: setting, url: settings_health_thresholds_path, method: :patch, class: "grid gap-4 p-4 sm:grid-cols-5" do |f| %>
    <% [ [ :health_disk_warn, t(".disk_warning") ], [ :health_disk_crit, t(".disk_critical") ], [ :health_memory_warn, t(".memory_warning") ],
         [ :health_memory_crit, t(".memory_critical") ] ].each do |field, label| %>
      <div>
        <%= f.label field, label, class: "label text-xs" %>
        <%= f.number_field field, in: 1..100, step: 1, required: true, class: "input mt-1" %>
      </div>
    <% end %>
    <div>
      <%= f.label :health_load_warn, t(".load_warning_processors"), class: "label text-xs" %>
      <%= f.number_field :health_load_warn, in: 0.1..50, step: 0.1, required: true, class: "input mt-1" %>
    </div>
    <div class="sm:col-span-5 flex items-center justify-between gap-3">
      <p class="text-xs text-ink-3"><%= t(".also_watch_reboot_required") %></p>
      <%= f.submit t(".save_thresholds"), class: "btn btn-primary" %>
    </div>
  <% end %>
</section>

<section id="firewall-settings" class="card mt-6">
  <div class="card-header">
    <h2 class="font-semibold"><%= t(".firewall_settings") %></h2>
    <span class="text-xs text-ink-3"><%= t(".firewall_settings_hint") %></span>
  </div>
  <%= form_with model: setting, url: settings_firewall_options_path, method: :patch, class: "firewall-options space-y-3 border-b border-line p-4" do |f| %>
    <label class="flex items-start gap-2 text-sm">
      <%= f.check_box :ufw_block_ipv6, class: "mt-0.5 rounded border-line" %>
      <span><span class="font-medium"><%= t(".ufw_block_ipv6") %></span><span class="block text-xs text-ink-3"><%= t(".ufw_block_ipv6_hint") %></span></span>
    </label>
    <label class="flex items-start gap-2 text-sm">
      <%= f.check_box :ovh_ipv6_health, class: "mt-0.5 rounded border-line" %>
      <span><span class="font-medium"><%= t(".ovh_ipv6_health") %></span><span class="block text-xs text-ink-3"><%= t(".ovh_ipv6_health_hint") %></span></span>
    </label>
    <div class="flex justify-end"><%= f.submit t(".save_firewall_options"), class: "btn btn-secondary" %></div>
  <% end %>
  <div class="p-4">
    <h3 class="text-sm font-medium"><%= t(".ssh_sources") %></h3>
    <p class="mt-1 text-xs text-ink-3"><%= t(".ssh_sources_hint") %></p>
    <p class="ssh-sources-warning mt-2 flex gap-2 rounded-lg bg-warn-soft px-3 py-2 text-xs text-warn-ink">
      <%= icon :exclamation_triangle, class: "h-4 w-4 shrink-0" %> <%= t(".ssh_sources_elio") %>
    </p>
    <% sources = SshSource.ordered.to_a %>
    <% if sources.any? %>
      <ul class="ssh-sources mt-3 divide-y divide-line rounded-lg border border-line">
        <% sources.each_with_index do |source, index| %>
          <li class="ssh-source flex items-center gap-3 px-3 py-2 text-sm" data-name="<%= source.name %>">
            <span class="font-medium"><%= source.name %></span>
            <span class="font-mono text-xs text-ink-2"><%= source.cidr %></span>
            <span class="ml-auto flex items-center gap-1">
              <%= button_to icon(:chevron_up, class: "h-4 w-4"), move_settings_ssh_source_path(source, direction: "up"), method: :patch, disabled: index.zero?,
                    class: "btn btn-ghost btn-icon", title: t(".move_up"), aria: { label: t(".move_up") } %>
              <%= button_to icon(:chevron_down, class: "h-4 w-4"), move_settings_ssh_source_path(source, direction: "down"), method: :patch, disabled: index == sources.size - 1,
                    class: "btn btn-ghost btn-icon", title: t(".move_down"), aria: { label: t(".move_down") } %>
              <%= button_to icon(:trash, class: "h-4 w-4"), settings_ssh_source_path(source), method: :delete,
                    data: { turbo_confirm: t(".delete_ssh_source", name: source.name), confirm_variant: "danger" },
                    class: "btn btn-ghost btn-icon text-crit-ink", title: t(".delete_source_label"), aria: { label: t(".delete_source_label") } %>
            </span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-3 text-xs text-ink-3"><%= t(".no_ssh_source") %></p>
    <% end %>
    <%= form_with model: SshSource.new, url: settings_ssh_sources_path, class: "add-ssh-source mt-3 flex flex-wrap items-end gap-3" do |f| %>
      <div>
        <%= f.label :name, t(".ssh_source_name"), class: "label text-xs" %>
        <%= f.text_field :name, required: true, maxlength: 40, placeholder: "Elio", class: "input mt-1 w-40" %>
      </div>
      <div>
        <%= f.label :cidr, t(".ssh_source_cidr"), class: "label text-xs" %>
        <%= f.text_field :cidr, required: true, placeholder: "203.0.113.5", autocomplete: "off", class: "input mt-1 w-56 font-mono" %>
      </div>
      <%= f.submit t(".add_ssh_source"), class: "btn btn-secondary" %>
    <% end %>
  </div>
</section>

<section id="prompt-instructions" class="card mt-6">
  <div class="card-header">
    <h2 class="font-semibold"><%= t(".prompt_instructions") %></h2>
    <span class="text-xs text-ink-3"><%= t(".prompt_instructions_hint") %></span>
  </div>
  <%= form_with url: settings_prompt_instructions_path, method: :patch, class: "space-y-4 p-4" do %>
    <% AppSetting::PROMPT_KINDS.each do |kind| %>
      <% next if kind == "monitors" && !Integration.enabled?(:uptime_kuma) && setting.prompt_instruction(kind).nil? %>
      <div>
        <%= label_tag "prompt_instructions_#{kind}", t(".prompt_labels.#{kind}"), class: "label text-xs" %>
        <%= text_area_tag "prompt_instructions[#{kind}]", setting.prompt_instructions[kind], id: "prompt_instructions_#{kind}", rows: 3,
              maxlength: AppSetting::PROMPT_INSTRUCTIONS_MAX, placeholder: t(".prompt_placeholders.#{kind}"), class: "input mt-1 w-full text-sm" %>
      </div>
    <% end %>
    <div class="flex items-center justify-between gap-3">
      <p class="text-xs text-ink-3"><%= t(".prompt_instructions_footer", count: AppSetting::PROMPT_INSTRUCTIONS_MAX) %></p>
      <%= submit_tag t(".save_prompt_instructions"), class: "btn btn-primary" %>
    </div>
  <% end %>
</section>
