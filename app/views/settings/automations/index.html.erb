<% content_for :title, t("title", page: t("nav.automations")) %>
<% page = capture do %>

<p class="text-sm text-ink-3">
  <%= t(".intro_html", activity: link_to(t(".activity"), activities_path, class: "font-medium text-accent hover:underline"), tasks: link_to(t(".tasks"), tasks_path, class: "font-medium text-accent hover:underline")) %>
</p>

<%# One form for the whole page (one Save); the "Run now" buttons submit small forms of their own, after it (form= attribute). %>
<%= form_with url: settings_automations_update_path, method: :patch, id: "automations-form", data: { controller: "dirty-form" } do |f| %>
  <div class="card overflow-x-auto">
    <table id="automations" class="table-dense">
      <thead>
        <tr><th class="pl-4"><%= t(".active") %></th><th><%= t(".automation") %></th><th><%= t(".frequency") %></th><% if @groups.any? %><th><%= t(".on") %></th><% end %>
            <th class="pr-4"><span class="sr-only"><%= t(".run_now") %></span></th></tr>
      </thead>
      <tbody>
        <% @automations.each do |automation| %>
          <% name = "automations[#{automation.id}]" %>
          <tr id="<%= dom_id(automation) %>" class="automation" data-enabled="<%= automation.enabled? %>">
            <td class="pl-4">
              <%= hidden_field_tag "#{name}[enabled]", "0", id: nil %>
              <%= check_box_tag "#{name}[enabled]", "1", automation.enabled?, id: "#{dom_id(automation)}_enabled", aria: { label: t(".enable", label: automation.label) },
                    class: "automation-enabled h-4 w-4 rounded border-line text-accent" %>
            </td>
            <td class="max-w-sm">
              <label for="<%= dom_id(automation) %>_enabled" class="font-medium"><%= automation.label %></label>
              <span class="automation-state sr-only"><%= automation.enabled? ? t(".text") : t(".off") %></span>
              <p class="truncate text-xs text-ink-3" title="<%= automation.description %>"><%= automation.description %></p>
              <p class="text-[11px] text-ink-3">
                <%= t(".last_run") %> <%= automation.last_run_at ? relative_time_tag(automation.last_run_at) : t(".never") %>
                <% if (next_run = automation.next_run_at) %> · <%= t(".next") %> <%= relative_time_tag next_run, expired: t(".next_minute") %><% end %>
                <% if automation.last_result %> · <span class="automation-result" title="<%= automation.last_result %>"><%= automation.last_result.truncate(60) %></span><% end %>
              </p>
            </td>
            <td><%= select_tag "#{name}[interval_minutes]", options_for_select(Automation.interval_options, automation.interval_minutes), aria: { label: t(".frequency") }, class: "input w-auto py-1 text-xs" %></td>
            <% if @groups.any? %>
              <td>
                <details class="automation-groups relative">
                  <summary class="automation-scope input cursor-pointer py-1 text-xs whitespace-nowrap"><%= automation.scope_label %></summary>
                  <div class="absolute right-0 z-10 mt-1 w-56 space-y-1 rounded-lg border border-line bg-surface p-2 shadow-lg">
                    <%= hidden_field_tag "#{name}[server_group_ids][]", "", id: nil %>
                    <p class="px-1 text-[11px] text-ink-3"><%= t(".group_checked_whole_fleet") %></p>
                    <% @groups.each do |group| %>
                      <label class="flex cursor-pointer items-center gap-2 rounded px-1 py-0.5 text-xs text-ink-2 hover:bg-subtle">
                        <%= check_box_tag "#{name}[server_group_ids][]", group.id, automation.server_group_ids.include?(group.id), id: "#{dom_id(automation)}_group_#{group.id}",
                              class: "h-3.5 w-3.5 rounded border-line text-accent" %>
                        <span class="h-2 w-2 rounded-full <%= group.dot_classes %>"></span><%= group.name %>
                      </label>
                    <% end %>
                  </div>
                </details>
              </td>
            <% end %>
            <td class="pr-4 text-right">
              <button type="submit" form="<%= dom_id(automation, :run) %>" class="btn btn-ghost px-2 py-1 text-xs text-accent"><%= icon :play, class: "h-3.5 w-3.5" %> <%= t(".run_now") %></button>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= save_bar f %>
<% end %>

<% @automations.each do |automation| %>
  <%= form_with url: run_settings_automation_path(automation), method: :post, id: dom_id(automation, :run), class: "hidden" do %><% end %>
<% end %>

<% end %>
<%= render "settings/frame", page: page %>
