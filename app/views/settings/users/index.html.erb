<% content_for :title, t("title", page: "#{t(".title")} · #{t("settings.nav.title")}") %>
<% page = capture do %>

<section id="invite" class="card p-5">
  <h2 class="text-sm font-semibold"><%= t(".invite") %></h2>
  <p class="mt-1 text-sm text-ink-3"><%= t(".invite_intro", count: Invitation::VALIDITY.in_days.to_i) %></p>
  <%= form_with model: @invitation, url: settings_invitations_path, class: "mt-4 flex flex-wrap items-end gap-3" do |f| %>
    <div class="min-w-60 flex-1">
      <%= f.label :email, t(".email"), class: "label" %>
      <%= f.email_field :email, required: true, placeholder: "alice@example.com",
            class: "input mt-1" %>
    </div>
    <div>
      <%= f.label :role, t(".role"), class: "label" %>
      <%= f.select :role, User.role_options, {},
            class: "input w-auto mt-1" %>
    </div>
    <div>
      <%= f.label :locale, t(".language"), class: "label" %>
      <%= f.select :locale, locale_options, { selected: @invitation.locale || I18n.locale.to_s }, class: "input w-auto mt-1" %>
    </div>
    <%= f.submit t(".create_invitation"), class: "btn btn-primary" %>
  <% end %>

  <% if @invitations.any? %>
    <h3 class="mt-6 text-sm font-semibold text-ink-2"><%= t(".pending") %></h3>
    <ul id="pending-invitations" class="mt-2 divide-y divide-line rounded-md border border-line">
      <% @invitations.each do |invitation| %>
        <li id="<%= dom_id(invitation) %>" class="pending-invitation flex flex-wrap items-center gap-3 px-4 py-3 text-sm" data-controller="clipboard">
          <div class="min-w-0 flex-1">
            <p class="font-medium"><%= invitation.email %> <span class="ml-1 rounded-full bg-subtle px-2 py-0.5 text-xs font-medium text-ink-2"><%= invitation.role_label %></span></p>
            <p class="text-xs text-ink-3"><%= t(".invited_by_html", email: invitation.invited_by.email, expiry: relative_time_tag(invitation.expires_at, prefix: t(".expires"))) %></p>
            <input type="text" readonly value="<%= invitation_acceptance_url(invitation.token) %>" data-clipboard-target="source" aria-label="<%= t(".link") %>"
                   class="invitation-link mt-2 block w-full rounded-md border border-line bg-subtle px-2 py-1 font-mono text-xs text-ink-2">
          </div>
          <%= render "settings/copy_button" %>
          <%= button_to settings_invitation_path(invitation), method: :delete, title: t(".revoke"), aria: { label: t(".revoke_label", email: invitation.email) },
                form: { data: { turbo_confirm: t(".revoke_confirm", email: invitation.email), confirm_label: t(".revoke"), confirm_variant: "danger" } },
                class: "cursor-pointer rounded-md p-1.5 text-ink-3 hover:bg-crit-soft hover:text-crit-ink" do %>
            <%= icon :trash %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>

<section id="security" class="card p-5">
  <h2 class="text-sm font-semibold"><%= t(".security") %></h2>
  <%= form_with model: @setting, url: settings_security_path, method: :patch, class: "mt-3 flex flex-wrap items-center gap-3" do |f| %>
    <label class="flex cursor-pointer items-center gap-2 text-sm text-ink-2">
      <%= f.check_box :require_admin_two_factor, class: "h-4 w-4 rounded border-line text-accent" %>
      <%= t(".admin_two_factor") %>
    </label>
    <label class="flex cursor-pointer items-center gap-2 text-sm text-ink-2">
      <%= f.check_box :require_operator_two_factor, class: "h-4 w-4 rounded border-line text-accent" %>
      <%= t(".operator_two_factor") %>
    </label>
    <%= f.submit t("words.save"), class: "btn btn-secondary" %>
  <% end %>
</section>

<section id="users" class="card p-5">
  <h2 class="text-sm font-semibold"><%= t(".title") %></h2>
  <p class="mt-1 text-xs text-ink-3"><%= t(".users_intro") %></p>
  <% select_class = "input w-auto px-2 py-1.5" %>
  <ul class="mt-4 divide-y divide-line rounded-md border border-line">
    <% @users.each do |user| %>
      <li id="<%= dom_id(user) %>" class="user-row flex flex-wrap items-center gap-3 px-4 py-3 text-sm <%= "is-deactivated bg-subtle" if user.deactivated? %>">
        <div class="min-w-48 flex-1">
          <p class="font-medium <%= "text-ink-3 line-through" if user.deactivated? %>"><%= user.email %><%= t(".you") if user == current_user %></p>
          <p class="text-xs text-ink-3">
            <% if user.deactivated? %>
              <span class="user-state font-medium text-crit-ink"><%= t(".deactivated") %></span> <%= relative_time_tag user.deactivated_at %>
            <% elsif user.last_sign_in_at %>
              <%= t(".last_sign_in") %> <%= relative_time_tag user.last_sign_in_at %>
            <% else %>
              <%= t(".never_signed_in") %>
            <% end %>
            · <span class="user-two-factor"><%= user.two_factor_enabled? ? t(".two_factor_on") : t(".two_factor_off") %></span>
          </p>
        </div>
        <%= form_with model: user, url: settings_user_path(user), class: "flex flex-wrap items-center gap-2", data: { controller: "auto-submit" } do |f| %>
          <%= f.select :role, User.role_options, {}, aria: { label: t(".role_of", email: user.email) }, class: select_class, data: { action: "change->auto-submit#submit" } %>
          <noscript><%= f.submit t("words.save"), class: "btn btn-secondary" %></noscript>
        <% end %>
        <% if user.deactivated? %>
          <%= button_to t(".reactivate"), reactivate_settings_user_path(user), class: "btn btn-secondary" %>
        <% elsif user != current_user || user.two_factor_enabled? %>
          <% if user != current_user %>
            <%= actions_menu label: t(".actions_of", email: user.email) do %>
              <% if user.two_factor_enabled? %>
                <%= menu_item t(".reset_two_factor"), reset_two_factor_settings_user_path(user), icon: :key, method: :post,
                              confirm: t(".reset_two_factor_confirm", email: user.email), data: { confirm_label: t(".reset") } %>
                <%= menu_separator %>
              <% end %>
              <%= menu_item t(".deactivate"), deactivate_settings_user_path(user), icon: :x_mark, method: :post, danger: true,
                            confirm: t(".deactivate_confirm", email: user.email), data: { confirm_label: t(".deactivate") } %>
            <% end %>
          <% end %>
        <% end %>
      </li>
    <% end %>
  </ul>
  <%= render "shared/pagination", pager: @pager, noun: t(".users") %>
</section>
<% end %>
<%= render "settings/frame", page: page %>
