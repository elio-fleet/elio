<% content_for :title, t("title", page: "#{t("settings.nav.extensions")} · #{t("settings.nav.title")}") %>
<% page = capture do %>

<p class="mt-6 text-sm text-ink-3">
  <%= t(".intro_html") %>
</p>

<div class="mt-5 grid grid-cols-1 gap-4 md:grid-cols-2">
  <% @integrations.each do |integration| %>
    <section id="integration-<%= integration.kind %>" class="integration card flex flex-col p-5">
      <div class="flex items-start justify-between gap-3">
        <h2 class="flex items-center gap-2 font-semibold"><%= icon integration.icon, class: "h-5 w-5 text-ink-3" %><%= integration.label %></h2>
        <%= integration.enabled? ? status_badge(:good, t(".text"), class: "integration-state") : status_badge(:neutral, t(".off"), class: "integration-state") %>
      </div>
      <p class="mt-2 flex-1 text-sm text-ink-2"><%= integration.description %></p>
      <% if integration.enabled? %>
        <p class="mt-3 text-xs text-ink-3">
          <% if integration.last_error %>
            <span class="integration-error text-crit-ink"><%= integration.last_error %></span>
          <% elsif integration.last_synced_at %>
            <%= t(".synchronized_html", last_synced_at: (relative_time_tag integration.last_synced_at)) %>
          <% else %>
            <%= t(".not_synchronized_yet") %>
          <% end %>
        </p>
      <% end %>
      <div class="mt-4">
        <%= link_to (integration.enabled? ? t(".configure") : t(".configure_turn")), edit_settings_integration_path(integration.kind), class: "btn btn-secondary" %>
      </div>
    </section>
  <% end %>
</div>
<% if Dns.enabled? && can?(:administer) %>
  <% settings = app_settings %>
  <section id="dns-alerts" class="card mt-5 p-5">
    <h2 class="flex items-center gap-2 font-semibold"><%= icon :globe, class: "h-5 w-5 text-ink-3" %><%= t("settings.dns_alerts.title") %></h2>
    <p class="mt-1 text-sm text-ink-2"><%= t("settings.dns_alerts.intro", sources: Dns.source_integrations.map { |integration| integration.definition.label }.to_sentence) %></p>
    <%= form_with url: settings_dns_alerts_path, method: :patch, scope: :dns_alerts, class: "mt-4 space-y-3 text-sm" do |f| %>
      <% [ [ :outside, settings.dns_alert_outside ], [ :without_name, settings.dns_alert_without_name ], [ :conflict, settings.dns_alert_conflict ] ].each do |key, checked| %>
        <label class="flex cursor-pointer items-start gap-2 text-ink-2">
          <%= f.check_box key, { checked: checked, class: "mt-0.5 h-4 w-4 rounded border-line text-accent" }, "1", "0" %>
          <span><%= t("settings.dns_alerts.#{key}") %> <span class="block text-xs text-ink-3"><%= t("settings.dns_alerts.#{key}_hint") %></span></span>
        </label>
      <% end %>
      <% groups = ServerGroup.order(:name).to_a %>
      <% if groups.any? %>
        <fieldset class="pl-6">
          <legend class="text-xs text-ink-3"><%= t("settings.dns_alerts.ignored_groups") %></legend>
          <div class="mt-1 flex flex-wrap gap-3">
            <% groups.each do |group| %>
              <label class="flex items-center gap-1.5 text-xs text-ink-2"><%= check_box_tag "dns_alerts[ignored_group_ids][]", group.id, settings.dns_without_name_ignored_group_ids.include?(group.id), id: "dns-ignored-#{group.id}", class: "h-4 w-4 rounded border-line" %><%= group.name %></label>
            <% end %>
          </div>
        </fieldset>
      <% end %>
      <%= f.submit t("settings.dns_alerts.save"), class: "btn btn-primary" %>
    <% end %>
  </section>
<% end %>
<% if @integrations.empty? %>
  <p class="card mt-5 px-4 py-6 text-sm text-ink-3"><%= t(".extension_available") %></p>
<% end %>
<% end %>
<%= render "settings/frame", page: page %>
