<%# When the API key of an extension expires (read from the service, Integration#credential_expires_at), in orange when it is close.
    Locals: integration. %>
<% if integration.credential_expires_at %>
  <p class="integration-credential mt-2 text-xs <%= integration.credential_expiring? ? "text-warn-ink" : "text-ink-3" %>">
    <%= t("settings.integrations.credential.expires", date: l(integration.credential_expires_at.to_date, format: :long)) %>
  </p>
<% end %>
