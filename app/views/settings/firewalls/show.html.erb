<% content_for :title, t("title", page: t("settings.nav.firewall")) %>
<% page = capture do %>

<section id="firewall-settings" class="card mt-6">
  <div class="card-header">
    <h2 class="font-semibold"><%= t("settings.show.firewall_settings") %></h2>
    <span class="text-xs text-ink-3"><%= t("settings.show.firewall_settings_hint") %></span>
  </div>
  <%= form_with model: app_settings, url: settings_firewall_options_path, method: :patch, class: "firewall-options space-y-3 border-b border-line p-4" do |f| %>
    <label class="flex items-start gap-2 text-sm">
      <%= f.check_box :ufw_block_ipv6, class: "mt-0.5 rounded border-line" %>
      <span><span class="font-medium"><%= t("settings.show.ufw_block_ipv6") %></span><span class="block text-xs text-ink-3"><%= t("settings.show.ufw_block_ipv6_hint") %></span></span>
    </label>
    <label class="flex items-start gap-2 text-sm">
      <%= f.check_box :ovh_ipv6_health, class: "mt-0.5 rounded border-line" %>
      <span><span class="font-medium"><%= t("settings.show.ovh_ipv6_health") %></span><span class="block text-xs text-ink-3"><%= t("settings.show.ovh_ipv6_health_hint") %></span></span>
    </label>
    <div class="flex justify-end"><%= f.submit t("settings.show.save_firewall_options"), class: "btn btn-secondary" %></div>
  <% end %>
  <div class="p-4">
    <h3 class="text-sm font-medium"><%= t("settings.show.ssh_sources") %></h3>
    <p class="mt-1 text-xs text-ink-3"><%= t("settings.show.ssh_sources_hint") %></p>
    <p class="ssh-sources-warning mt-2 flex gap-2 rounded-lg bg-warn-soft px-3 py-2 text-xs text-warn-ink">
      <%= icon :exclamation_triangle, class: "h-4 w-4 shrink-0" %> <%= t("settings.show.ssh_sources_elio") %>
    </p>
    <% sources = SshSource.ordered.to_a %>
    <% if sources.any? %>
      <ul class="ssh-sources mt-3 divide-y divide-line rounded-lg border border-line">
        <% sources.each_with_index do |source, index| %>
          <li class="ssh-source flex items-center gap-3 px-3 py-2 text-sm" data-name="<%= source.name %>">
            <span class="font-medium"><%= source.name %></span>
            <span class="font-mono text-xs text-ink-2"><%= source.cidr %></span>
            <span class="ml-auto flex items-center gap-1">
              <%= button_to icon(:chevron_up, class: "h-4 w-4"), move_settings_ssh_source_path(source, direction: "up"), method: :patch, disabled: index.zero?,
                    class: "btn btn-ghost btn-icon", title: t("settings.show.move_up"), aria: { label: t("settings.show.move_up") } %>
              <%= button_to icon(:chevron_down, class: "h-4 w-4"), move_settings_ssh_source_path(source, direction: "down"), method: :patch, disabled: index == sources.size - 1,
                    class: "btn btn-ghost btn-icon", title: t("settings.show.move_down"), aria: { label: t("settings.show.move_down") } %>
              <%= button_to icon(:trash, class: "h-4 w-4"), settings_ssh_source_path(source), method: :delete,
                    data: { turbo_confirm: t("settings.show.delete_ssh_source", name: source.name), confirm_variant: "danger" },
                    class: "btn btn-ghost btn-icon text-crit-ink", title: t("settings.show.delete_source_label"), aria: { label: t("settings.show.delete_source_label") } %>
            </span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-3 text-xs text-ink-3"><%= t("settings.show.no_ssh_source") %></p>
    <% end %>
    <%= form_with model: SshSource.new, url: settings_ssh_sources_path, class: "add-ssh-source mt-3 flex flex-wrap items-end gap-3" do |f| %>
      <div>
        <%= f.label :name, t("settings.show.ssh_source_name"), class: "label text-xs" %>
        <%= f.text_field :name, required: true, maxlength: 40, placeholder: "Elio", class: "input mt-1 w-40" %>
      </div>
      <div>
        <%= f.label :cidr, t("settings.show.ssh_source_cidr"), class: "label text-xs" %>
        <%= f.text_field :cidr, required: true, placeholder: "203.0.113.5", autocomplete: "off", class: "input mt-1 w-56 font-mono" %>
      </div>
      <%= f.submit t("settings.show.add_ssh_source"), class: "btn btn-secondary" %>
    <% end %>
  </div>
</section>
<% end %>
<%= render "settings/frame", page: page %>
