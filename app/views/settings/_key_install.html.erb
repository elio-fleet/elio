<%# Commands installing Elio's key for the chosen account (guide: a KeyInstallGuide). Its GET form reloads only this frame; nothing is saved, Elio never runs them. %>
<%= turbo_frame_tag "ssh-key-install", class: "mt-6 block" do %>
  <h3 class="text-sm font-semibold"><%= t("settings.key_install.title") %></h3>

  <%= form_with url: settings_path, method: :get, scope: :install, id: "ssh-key-install-form",
        data: { controller: "auto-submit", turbo_frame: "ssh-key-install" },
        class: "mt-3 flex flex-wrap items-end gap-4" do |f| %>
    <div class="w-full sm:w-64">
      <%= f.label :account, t("settings.key_install.account"), class: "label" %>
      <%= f.select :account, KeyInstallGuide::ACCOUNTS.map { |account| [ KeyInstallGuide.account_label(account), account ] },
            { selected: guide.account }, class: "input mt-1", data: { action: "change->auto-submit#submit" } %>
    </div>
    <% if guide.dedicated? %>
      <div class="w-full sm:w-40">
        <%= f.label :username, t("settings.key_install.username"), class: "label" %>
        <%= f.text_field :username, value: guide.username, class: "input mt-1 font-mono", autocomplete: "off", spellcheck: false %>
      </div>
    <% end %>
    <div class="w-full min-w-0 sm:w-auto sm:flex-1">
      <%= f.label :from, t("settings.key_install.from"), class: "label" %>
      <%= f.text_field :from, value: guide.from, placeholder: "203.0.113.10", class: "input mt-1 font-mono", autocomplete: "off", spellcheck: false %>
    </div>
    <%= f.submit t("settings.key_install.apply"), name: nil, class: "btn btn-secondary" %>
  <% end %>

  <% guide.errors.each do |field| %>
    <p class="key-install-error mt-2 text-xs text-crit-ink"><%= t("settings.key_install.errors.#{field}") %></p>
  <% end %>
  <p class="mt-2 max-w-3xl text-xs text-ink-3"><%= t("settings.key_install.from_hint") %></p>

  <div class="mt-4" data-controller="clipboard">
    <div class="flex items-end justify-between gap-4">
      <label for="ssh-install-command" class="text-sm font-medium text-ink-2"><%= t("settings.key_install.run_as.#{guide.account}", username: guide.username) %></label>
      <%= render "settings/copy_button" %>
    </div>
    <textarea id="ssh-install-command" readonly rows="<%= guide.dedicated? ? 5 : 3 %>" data-clipboard-target="source"
              class="mt-2 block w-full resize-none rounded-md border border-line bg-neutral-950 px-3 py-2 font-mono text-xs text-neutral-100"><%= guide.command %></textarea>
  </div>

  <% if guide.sudoers_command %>
    <div class="mt-4" data-controller="clipboard">
      <div class="flex items-end justify-between gap-4">
        <label for="ssh-sudoers-command" class="text-sm font-medium text-ink-2"><%= t("settings.key_install.sudoers") %></label>
        <%= render "settings/copy_button" %>
      </div>
      <textarea id="ssh-sudoers-command" readonly rows="2" data-clipboard-target="source"
                class="mt-2 block w-full resize-none rounded-md border border-line bg-neutral-950 px-3 py-2 font-mono text-xs text-neutral-100"><%= guide.sudoers_command %></textarea>
    </div>
  <% end %>

  <p id="ssh-key-install-next" class="mt-2 max-w-3xl text-xs text-ink-3">
    <%= t("settings.key_install.next.#{guide.account}_html", username: tag.code(guide.username, class: "font-mono")) %>
  </p>
<% end %>
