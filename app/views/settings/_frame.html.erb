<%# Layout of every settings page: the page header, the menu of the settings on the left, the page (captured by the view, local `page`) on the right. %>
<%= page_header t("settings.nav.title"), subtitle: t("settings.nav.subtitle") %>
<div class="grid items-start gap-6 lg:grid-cols-[13rem_minmax(0,1fr)]">
  <nav class="settings-nav scrollbar-none flex gap-1 overflow-x-auto lg:sticky lg:top-6 lg:flex-col lg:overflow-visible" aria-label="<%= t("settings.nav.title") %>">
    <% [ [ t("settings.nav.general"), settings_path, controller_path == "settings" || controller_path == "settings/key_rotations", :cog ],
         [ t("settings.nav.users"), settings_users_path, controller_path.in?(%w[settings/users settings/invitations]), :user ],
         [ t("settings.nav.notifications"), settings_notifications_path, controller_path.start_with?("settings/notification"), :pulse ],
         [ t("settings.nav.automations"), settings_automations_path, controller_path == "settings/automations", :bolt ],
         [ t("settings.nav.vulnerabilities"), settings_vulnerabilities_path, controller_path.in?(%w[settings/vulnerabilities settings/score_providers]), :shield_exclamation ],
         [ t("settings.nav.docker"), settings_docker_path, controller_path == "settings/docker", :docker ],
         [ t("settings.nav.firewall"), settings_firewall_path, controller_path == "settings/firewalls", :shield_check ],
         [ t("settings.nav.extensions"), settings_integrations_path, controller_path == "settings/integrations", :signal ] ].each do |label, path, active, icon_name| %>
      <%= link_to path, aria: { current: (active ? "page" : nil) },
            class: "flex shrink-0 items-center gap-2 rounded-lg px-3 py-1.5 text-sm whitespace-nowrap #{active ? "border border-line bg-surface font-medium text-ink" : "border border-transparent text-ink-2 hover:bg-subtle hover:text-ink"}" do %>
        <%= icon icon_name, class: "h-4 w-4 text-ink-3" %><%= label %>
      <% end %>
    <% end %>
  </nav>
  <div class="settings-page flex min-w-0 flex-col gap-4">
    <%= page %>
  </div>
</div>
