<%# "DNS" tab of a server: the names that point to it, from every DNS source (OVHcloud, Technitium…). %>
<% records = server.dns_records.order(:zone, :name, :record_type, :source).to_a %>
<section id="server-dns" class="card mt-6">
  <div class="card-header">
    <h2 class="flex items-center gap-2 font-semibold"><%= icon :globe, class: "h-4 w-4 text-ink-3" %> <%= t("dns_records.server_tab.title") %></h2>
    <%= link_to t("dns_records.server_tab.all_records"), dns_records_path, class: "text-xs text-accent hover:underline" %>
  </div>
  <% if records.any? %>
    <div class="overflow-x-auto">
      <table class="table-dense">
        <thead><tr><th class="pl-4"><%= t("dns_records.index.name") %></th><th>Type</th><th><%= t("dns_records.index.value") %></th><th><%= t("dns_records.index.source") %></th><th><%= t("dns_records.server_tab.matched") %></th><% if can?(:operate) %><th class="pr-4 text-right"><%= t("dns_records.index.attach") %></th><% end %></tr></thead>
        <tbody>
          <% records.each do |record| %>
            <tr class="dns-record" data-name="<%= record.name %>" data-source="<%= record.source %>">
              <td class="pl-4 font-mono text-xs"><%= record.name %></td>
              <td class="font-mono text-xs"><%= record.record_type %></td>
              <td class="font-mono text-xs"><%= record.value %></td>
              <td><%= dns_source_badge(record.source) %></td>
              <td class="text-xs text-ink-3"><%= record.matched_label %></td>
              <% if can?(:operate) %><td class="pr-4"><%= render "dns_records/link_form", record: record %></td><% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="dns-none px-4 py-6 text-sm text-ink-3">
      <%= t("dns_records.server_tab.none") %>
      <%= link_to t("dns_records.server_tab.see_unattached"), dns_records_path(filter: "unattached"), class: "font-medium text-accent hover:underline" %>
    </p>
  <% end %>
</section>
