<% content_for :title, t("title", page: t("dns_records.tab")) %>

<% sources = capture do %>
    <ul class="dns-sources mt-1 flex flex-wrap gap-x-4 gap-y-1 text-xs text-ink-3">
      <% @sources.each do |source| %>
        <li data-source="<%= source.key %>">
          <%= dns_source_badge(source.key) %>
          <% if source.last_synced_at %><%= t("dns_records.index.synchronized_html", time: relative_time_tag(source.last_synced_at)) %><% else %><%= t("dns_records.index.not_synchronized_yet") %><% end %>
          <% if source.last_error %><span class="text-crit-ink"><%= t("dns_records.index.last_sync_failed", error: source.last_error) %></span><% end %>
          <% if can?(:administer) %>· <%= link_to t("dns_records.index.settings"), edit_settings_integration_path(source.integration.kind), class: "text-accent hover:underline" %><% end %>
        </li>
      <% end %>
    </ul>
<% end %>
<%= page_header t("dns_records.index.title"), subtitle: safe_join([ t("dns_records.index.intro"), sources ]) %>

<%= stat_tiles do %>
  <%= stat_tile t("dns_records.index.records"), @counts[:total], nil, icon: :globe, id: "stat-dns-records", href: dns_records_path, active: @filter.nil? %>
  <%= stat_tile t("dns_records.index.outside"), @counts[:outside], t("dns_records.index.outside_caption"), tone: (:warn if @counts[:outside].positive?), icon: :exclamation_triangle, id: "stat-dns-outside",
                href: dns_records_path(filter: "outside"), active: @filter == "outside" %>
  <%= stat_tile t("dns_records.index.unattached"), @counts[:unattached], nil, icon: :list_bullet, id: "stat-dns-unattached", href: dns_records_path(filter: "unattached"), active: @filter == "unattached" %>
  <%= stat_tile t("dns_records.index.servers_without"), @counts[:servers_without], nil, icon: :server_stack, id: "stat-dns-servers-without" %>
<% end %>

<div class="filter-bar mb-3 flex flex-wrap items-center gap-2">
  <nav class="dns-filters flex flex-wrap gap-2" aria-label="<%= t("dns_records.index.filters") %>">
    <% [ [ t("dns_records.index.all"), nil ], [ t("dns_records.index.outside"), "outside" ], [ t("dns_records.index.unattached"), "unattached" ],
         *([ [ t("dns_records.index.conflicts"), "conflicts", @counts[:conflicts] ] ] if @sources.size > 1 || @counts[:conflicts].positive?) ].each do |label, filter, count| %>
      <%= filter_chip label, dns_records_path(filter: filter, zone: @zone, source: @source), active: @filter == filter, count: count&.nonzero?, data: { filter: filter || "all" } %>
    <% end %>
  </nav>
  <%= form_with url: dns_records_path, method: :get, data: search_form_data, class: "ml-auto flex flex-wrap items-center gap-2" do |f| %>
    <%= hidden_field_tag :filter, @filter if @filter %>
    <% if @sources.size > 1 %>
      <%= f.select :source, [ [ t("dns_records.index.all_sources"), "" ], *@sources.map { |source| [ source.label, source.key ] } ], { selected: @source },
            aria: { label: t("dns_records.index.source") }, data: { action: "change->auto-submit#submit" }, class: "input w-auto py-1.5" %>
    <% end %>
    <% if @zones.size > 1 %>
      <%= f.select :zone, [ [ t("dns_records.index.all_zones"), "" ], *@zones.map { |zone| [ zone, zone ] } ], { selected: @zone },
            aria: { label: t("dns_records.index.zone") }, data: { action: "change->auto-submit#submit" }, class: "input w-auto py-1.5" %>
    <% end %>
    <%= f.search_field :q, value: @q, placeholder: t("dns_records.index.search"), aria: { label: t("dns_records.index.search") },
          data: { action: "input->auto-submit#submitLater" }, class: "input w-56 py-1.5" %>
  <% end %>
</div>

<%= search_results_frame do %>
  <% if @ip_names %>
    <p class="dns-ip-names mb-3 text-sm text-ink-2">
      <%= t("dns_records.index.ip_names", count: @ip_names.size, ip: @q) %><% if @ip_names.any? %> <span class="font-mono text-xs"><%= @ip_names.join(", ") %></span><% end %>
    </p>
  <% end %>
  <% if @records.any? %>
    <% bulk = can?(:operate) %>
    <div class="card overflow-x-auto" <%= tag.attributes(data: { controller: "check-all" }) if bulk %>>
      <table id="dns-records" class="table-dense">
        <thead><tr><% if bulk %><th class="pl-4 w-8"><button type="button" data-action="check-all#toggle" class="cursor-pointer text-xs font-medium text-accent"><%= t("dns_records.index.all") %></button></th><% end %><th class="<%= "pl-4" unless bulk %>"><%= t("dns_records.index.name") %></th><th>Type</th><th><%= t("dns_records.index.value") %></th><th><%= t("dns_records.index.source") %></th><th><%= t("dns_records.index.server") %></th><% if can?(:operate) %><th class="pr-4 text-right"><%= t("dns_records.index.attach") %></th><% end %></tr></thead>
        <tbody>
          <% @records.each do |record| %>
            <tr class="dns-record" data-name="<%= record.name %>" data-type="<%= record.record_type %>" data-source="<%= record.source %>">
              <% if bulk %>
                <td class="pl-4"><%= check_box_tag "record_ids[]", record.id, false, id: dom_id(record, :select), form: "dns-link-batch", class: "rounded border-line",
                                       data: { check_all_target: "checkbox" }, aria: { label: t("dns_records.index.select", name: record.name) } %></td>
              <% end %>
              <td class="<%= "pl-4" unless bulk %> font-mono text-xs"><%= record.name %><% if record.disabled %> <span class="badge bg-subtle text-ink-3"><%= t("dns_records.index.disabled") %></span><% end %>
                <span class="block font-sans text-[11px] text-ink-3"><%= record.zone %></span></td>
              <td class="font-mono text-xs"><%= record.record_type %></td>
              <td class="font-mono text-xs"><%= record.value %></td>
              <td><%= dns_source_badge(record.source) %><% if @conflicts.include?(record.name) %> <%= dns_conflict_badge %><% end %></td>
              <td class="text-xs">
                <% if record.server %>
                  <%= link_to record.server.name, server_path(record.server, tab: "dns"), class: "font-medium hover:text-accent hover:underline" %>
                  <span class="block text-[11px] text-ink-3"><%= record.matched_label %></span>
                <% elsif record.address? %>
                  <%= status_badge :warn, t("dns_records.index.outside_fleet"), class: "dns-outside" %>
                <% else %>
                  <span class="text-ink-3">—</span>
                <% end %>
              </td>
              <% if can?(:operate) %><td class="pr-4"><%= render "dns_records/link_form", record: record %></td><% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% if bulk %>
      <%= form_with url: dns_link_batch_path, id: "dns-link-batch", data: { turbo_frame: "_top" }, class: "mt-3 flex flex-wrap items-center gap-2 text-sm" do |f| %>
        <%= label_tag "dns_link_batch_server", t("dns_records.index.bulk_attach"), class: "text-ink-2" %>
        <%= f.select :server_id, [ [ t("dns_records.index.bulk_choose"), "" ], [ t("dns_records.link.server"), DnsLinkBatchesController::NONE ],
                                   [ t("dns_records.link.automatic"), DnsLinkBatchesController::AUTOMATIC ], *server_options ],
              {}, id: "dns_link_batch_server", required: true, class: "input w-auto max-w-56 py-1.5" %>
        <%= f.submit t("dns_records.link.attach"), class: "btn btn-secondary" %>
      <% end %>
    <% end %>
    <%= render "shared/pagination", pager: @pager, noun: t("dns_records.index.records").downcase %>
  <% else %>
    <p class="card px-4 py-6 text-sm text-ink-3"><%= DnsRecord.exists? ? t("dns_records.index.none") : t("dns_records.index.no_record_yet") %></p>
  <% end %>
<% end %>
