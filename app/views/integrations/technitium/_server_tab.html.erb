<%# "DNS" tab of a server (Technitium DNS extension): the names that point to it. %>
<% records = server.technitium_records.order(:zone, :name, :record_type).to_a %>
<section id="server-dns" class="card mt-6">
  <div class="card-header">
    <h2 class="flex items-center gap-2 font-semibold"><%= icon :globe, class: "h-4 w-4 text-ink-3" %> <%= t("integrations.technitium.server_tab.title") %></h2>
    <span class="text-xs text-ink-3">
      <% if integration.last_synced_at %><%= t("integrations.technitium.server_tab.synchronized_html", time: relative_time_tag(integration.last_synced_at)) %> · <% end %>
      <%= link_to t("integrations.technitium.server_tab.all_records"), technitium_records_path, class: "text-accent hover:underline" %>
    </span>
  </div>
  <% if records.any? %>
    <div class="overflow-x-auto">
      <table class="table-dense">
        <thead><tr><th class="pl-4"><%= t("technitium_records.index.name") %></th><th>Type</th><th><%= t("technitium_records.index.value") %></th><th><%= t("integrations.technitium.server_tab.matched") %></th><% if can?(:operate) %><th class="pr-4 text-right"><%= t("technitium_records.index.attach") %></th><% end %></tr></thead>
        <tbody>
          <% records.each do |record| %>
            <tr class="dns-record" data-name="<%= record.name %>">
              <td class="pl-4 font-mono text-xs"><%= record.name %></td>
              <td class="font-mono text-xs"><%= record.record_type %></td>
              <td class="font-mono text-xs"><%= record.value %></td>
              <td class="text-xs text-ink-3"><%= record.matched_label %></td>
              <% if can?(:operate) %><td class="pr-4"><%= render "integrations/technitium/link_form", record: record %></td><% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="dns-none px-4 py-6 text-sm text-ink-3">
      <%= t("integrations.technitium.server_tab.none") %><%= t("integrations.technitium.server_tab.not_synchronized") unless integration.last_synced_at %>
      <%= link_to t("integrations.technitium.server_tab.see_unattached"), technitium_records_path(filter: "unattached"), class: "font-medium text-accent hover:underline" %>
    </p>
  <% end %>
</section>
