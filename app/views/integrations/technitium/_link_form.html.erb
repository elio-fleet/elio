<%# Manual attachment of a DNS name (operators): every record of the name follows. %>
<div class="flex items-center justify-end gap-1">
  <%= form_with url: technitium_record_link_path(record), method: :post, class: "technitium-link-form", data: { controller: "auto-submit", turbo_frame: "_top" } do |f| %>
    <%= f.select :server_id, [ [ t("integrations.technitium.link.server"), "" ], *server_options ], { selected: record.server_id },
          aria: { label: t("integrations.technitium.link.server_of", name: record.name) }, data: { action: "change->auto-submit#submit" }, class: "input w-auto max-w-40 py-1 text-xs" %>
    <noscript><%= f.submit t("integrations.technitium.link.attach"), class: "btn btn-secondary" %></noscript>
  <% end %>
  <% if record.matched_by == "manual" %>
    <%= button_to technitium_record_link_path(record), method: :delete, title: t("integrations.technitium.link.automatic"), aria: { label: t("integrations.technitium.link.automatic") },
          form: { data: { turbo_frame: "_top" } }, class: "btn btn-ghost btn-icon" do %><%= icon :arrow_path, class: "h-4 w-4" %><% end %>
  <% end %>
</div>
